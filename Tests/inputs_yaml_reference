## GUST master YAML input reference (every key of the case description read by
## tools/make_gust_case.py, with defaults, units, ranges and meaning).
##
## Generated by tools/make_gust_case.py --write-yaml-reference; do not edit by
## hand. The CTest gust_case_selftest checks that this file is current and
## holds every key.
##
## Every line is a comment. Copy the lines you need into a case file and remove
## the leading "# " (lines that start with "##" stay comments); what is left is
## YAML, with the text below each key still a comment. A key line reads
## "key: default". An empty value with "# required" means the key has no
## default; with "# none", that the key is absent unless given. A unit follows
## in brackets. Not every key can be given with every other: the text says
## which exclude each other, and the tool refuses a case that mixes them. docs/case_setup.rst describes the sections;
## Tests/inputs_reference lists GUST's own deck inputs, which the gust_inputs
## section passes through.


##==================================================================================================================
## case: Name and place of the case folder.
##==================================================================================================================
#
# case:
#   name: gust_case
#       # Name of the case folder, written under output_dir: letters, digits, _, - and ., not starting with a dot.
#       # Accepts text.
#
#   output_dir: .
#       # Folder the case folder is made in; relative to the YAML file. Accepts a file path.
#
#   description: ""
#       # One line copied to the top of every deck. Accepts text.


##==================================================================================================================
## domain: The box: centre, extent and top.
##==================================================================================================================
#
# domain:
#   center:    # none [m]
#       # Centre of the domain in the terrain file's projected frame (easting, northing). Not with center_lat_lon.
#       # Absent (and no center_lat_lon): 0 0. Accepts 2 numbers.
#
#   center_lat_lon:    # none [degrees]
#       # Centre of the domain as latitude, longitude (WGS 84); converted to UTM. Required with a terrain file in
#       # latitude and longitude. Accepts 2 numbers.
#
#   utm_zone:    # none
#       # UTM zone of the projection. Default: the zone of center_lat_lon. Accepts an integer ≥ 1 and ≤ 60.
#
#   half_width:    # none [m]
#       # Distance from the centre to the domain's faces: one number, or two (east–west, north–south). Not with
#       # west, east, south, north. Accepts a list of numbers > 0.
#
#   west:    # none [m]
#       # Distance from the centre to the west face. Accepts a number > 0.
#
#   east:    # none [m]
#       # Distance from the centre to the east face. Accepts a number > 0.
#
#   south:    # none [m]
#       # Distance from the centre to the south face. Accepts a number > 0.
#
#   north:    # none [m]
#       # Distance from the centre to the north face. Accepts a number > 0.
#
#   top:    # required [m]
#       # Height of the domain above the zero level of the terrain. Accepts a number > 0.
#
#   origin: center
#       # Where x = y = 0 of the case is: the domain centre or its south-west corner. Accepts center, southwest.


##==================================================================================================================
## terrain: Elevation data and how it becomes GUST's terrain.xyz.
##==================================================================================================================
#
# terrain:
#   file:    # none
#       # Elevation data. Absent: flat ground. Accepts a file path.
#
#   format: auto
#       # geotiff (single band), esri_ascii (.asc grid) or xyz (x y z points); auto goes by the file's extension.
#       # Accepts auto, geotiff, esri_ascii, xyz.
#
#   coordinates: auto
#       # projected (metres) or geographic (longitude, latitude); auto: geographic when the file's extent fits in
#       # ±180, ±90. Accepts auto, projected, geographic.
#
#   zero_level: lowest    # [m]
#       # Elevation that becomes z = 0: the lowest point kept, none (the file's own datum) or a number. Accepts a
#       # number, or lowest or none.
#
#   smoothing: btf
#       # The terrain-following coordinate: btf, stf or sullivan (terrain.smoothing 0, 1, 2). Accepts btf, stf,
#       # sullivan.
#
#   point_spacing: auto    # [m]
#       # Spacing of the points written to terrain.xyz. auto: the data's own, thinned to no finer than half a cell.
#       # Accepts a number > 0, or auto.
#
#   margin: auto    # [m]
#       # Width of the band of points kept outside the domain. auto: 4 cells. Accepts a number ≥ 0, or auto.
#
#   idw_neighbors:    # none
#       # terrain.idw_neighbors (GUST's default 6). Accepts an integer ≥ 1.
#
#   idw_power:    # none
#       # terrain.idw_power (GUST's default 2). Accepts a number > 0.
#
#   border:
#     flat_width: 0    # [m]
#         # Width of the flat band inside each lateral face. Accepts a number ≥ 0.
#
#     slope_width: 0    # [m]
#         # Width over which the ground goes from the flat band to the data. 0 with flat_width 0: the border is left
#         # as the data give it. Accepts a number ≥ 0.
#
#     level: lowest    # [m]
#         # Elevation of the flat band: the lowest point kept, mean (the mean elevation) or a number in the file's
#         # datum. Accepts a number, or lowest or mean.


##==================================================================================================================
## mesh: Cell size, layers and grid hierarchy.
##==================================================================================================================
#
# mesh:
#   cell_size:    # required [m]
#       # Target horizontal cell size. The cell counts are the nearest multiples of 8, so the actual size differs
#       # slightly. Accepts a number > 0.
#
#   layers:    # none
#       # Number of layers. Required unless first_layer and stretch_ratio are given. Accepts an integer ≥ 1.
#
#   first_layer:    # none [m]
#       # Thickness of the first layer. Absent: uniform layers. Accepts a number > 0.
#
#   stretch_ratio:    # none
#       # Ratio between successive layers. With first_layer and no layers: the largest ratio allowed, and the layer
#       # count follows. With both: the ratio written to the deck (the top is then where the layers end). Accepts a
#       # number ≥ 1.
#
#   hierarchy_levels: auto
#       # Levels of the grid hierarchy. auto: up to 3, as the cell counts allow. Accepts an integer ≥ 1 and ≤ 10, or
#       # auto.
#
#   max_grid_size: 64
#       # Largest box size in x and y. Accepts an integer ≥ 1.


##==================================================================================================================
## wind: Speed, direction and what drives the flow.
##==================================================================================================================
#
# wind:
#   speed:    # none [m/s]
#       # Wind speed at the reference height. Accepts a number > 0.
#
#   height:    # none [m]
#       # Reference height above the ground. Accepts a number > 0.
#
#   direction:    # none [degrees]
#       # Direction the wind comes from, clockwise from north (270: from the west). Accepts a number ≥ 0 and ≤ 360.
#
#   directions:    # none
#       # A sweep: a list of directions, or start, stop and step. One run folder per direction. Not with direction.
#       # Accepts see the text.
#
#   drive: inflow_only
#       # What drives the flow (abl.drive): inflow_only, couette (a moving lid at the log law's speed),
#       # geostrophic_column or geostrophic_inflow (Coriolis and a geostrophic wind; the inflow profile comes from a
#       # column run made first). Accepts inflow_only, couette, geostrophic_column, geostrophic_inflow.
#
#   profile: log_law
#       # The inflow profile: log_law, power_law or table (a file of z u v theta [k] rows). Accepts log_law,
#       # power_law, table.
#
#   power_law_exponent:    # none
#       # Exponent of the power law (GUST's default 0.14). Accepts a number > 0.
#
#   table:    # none
#       # The profile table; copied into the case folder. With profile: table. Accepts a file path.
#
#   upstream_roughness:    # none [m]
#       # Roughness length of the inflow profile. Default: surface.roughness. Accepts a number > 0.
#
#   side_faces: slip_wall
#       # The two faces parallel to a wind along x or y; not with a geostrophic drive. Accepts slip_wall, periodic.


##==================================================================================================================
## atmosphere: Potential temperature, the Rayleigh layer and rotation.
##==================================================================================================================
#
# atmosphere:
#   theta: neutral
#       # How potential temperature is treated (abl.theta): neutral (buoyancy off), capped (an inversion or lapse
#       # rate aloft, solved), frozen (the sounding held) or surface_flux. Accepts neutral, capped, frozen,
#       # surface_flux.
#
#   reference_temperature: 300    # [K]
#       # Potential temperature below the inversion. Accepts a number > 0.
#
#   inversion:
#     base:    # none [m]
#         # Height of the inversion's base. Accepts a number > 0.
#
#     thickness:    # none [m]
#         # Thickness of the inversion. Accepts a number > 0.
#
#     strength:    # none [K]
#         # Rise of potential temperature across the inversion. Accepts a number ≥ 0.
#
#   lapse_rate:    # none [K/m]
#       # Gradient of potential temperature above the inversion (or above the ground without one); also the gradient
#       # held at the top. Accepts a number ≥ 0.
#
#   sounding:
#     heights:    # none [m]
#         # Heights of a sounding, increasing from 0. Not with inversion. Accepts a list of numbers ≥ 0.
#
#     theta:    # none [K]
#         # Potential temperature at those heights. Accepts a list of numbers > 0.
#
#   damping:
#     start: auto    # [m]
#         # Height where the Rayleigh layer starts. auto: 0.7 of the top. none: no layer. Accepts a number > 0, or
#         # auto or none.
#
#     coefficient: 0.2    # [1/s]
#         # Rayleigh coefficient. Accepts a number > 0.
#
#     fields:    # none
#         # Fields damped. Default: w (w and theta with theta: capped). Accepts a list of words.
#
#   latitude:    # none [degrees]
#       # Latitude of the Coriolis force. Default: that of domain.center_lat_lon. Accepts a number ≥ -90 and ≤ 90.
#
#   geostrophic_wind:    # none [m/s]
#       # Geostrophic wind (east, north components). With a geostrophic drive: given here, or found by the column
#       # run from wind.speed at wind.height. Accepts 2 numbers.
#
#   surface_heat_flux:    # none [K m/s]
#       # Kinematic surface heat flux; with theta: surface_flux. Accepts a number.


##==================================================================================================================
## surface: Roughness, canopy and buildings.
##==================================================================================================================
#
# surface:
#   roughness:    # none [m]
#       # Uniform roughness length. Required unless roughness_map is given. Accepts a number > 0.
#
#   roughness_map:
#     file:    # none
#         # A roughness map: x y z0 points, or a land-cover raster. Accepts a file path.
#
#     format: auto
#         # xyz (x y z0 points, in the terrain file's frame) or land_cover (a GeoTIFF or ESRI ASCII raster of class
#         # codes). auto goes by the extension. Accepts auto, xyz, land_cover.
#
#     classes: esa_cci
#         # The class table of a land-cover raster: esa_cci, or a mapping of class code to roughness length (m).
#         # Accepts see the text.
#
#     default:    # none [m]
#         # Roughness length of a class the table does not hold. Absent: such a class is refused. Accepts a number >
#         # 0.
#
#     coordinates: auto
#         # As terrain.coordinates. Accepts auto, projected, geographic.
#
#   canopy:
#     patches_file:    # none
#         # Round forest patches (ERF's forest file; canopy.type = patches). Coordinates in the case frame. Accepts
#         # a file path.
#
#     height_file:    # none
#         # x y h points of canopy height (canopy.type = map), case frame. Accepts a file path.
#
#     lai_file:    # none
#         # x y LAI points; with height_file. Accepts a file path.
#
#     cd:    # none
#         # Drag coefficient of every column; with height_file. Accepts a number > 0.
#
#     cd_file:    # none
#         # x y cd points; with height_file, not with cd. Accepts a file path.
#
#     profile: uniform
#         # Shape of the leaf area density. Accepts uniform, lalic_mihailovic.
#
#   buildings:
#     file:    # none
#         # Building height map (buildings.type = immersed_forcing), case frame. Accepts a file path.
#
#     format: erf
#         # erf or xyz (buildings.format). Accepts erf, xyz.


##==================================================================================================================
## model: Closure settings.
##==================================================================================================================
#
# model:
#   lee_setting: recommended
#       # recommended: turb.realizability = 0.309, turb.nut_relax = 0.5 and the convection blend (0.1 below
#       # blend_height). none: GUST's defaults. Accepts recommended, none.
#
#   blend_height: auto    # [m]
#       # convection.hybrid_height. auto: 2.5 times the terrain's relief, highest less lowest point in the domain, a
#       # regional slope included (no blend over flat ground). Accepts a number > 0, or auto.
#
#   length_scale_cap: auto    # [m]
#       # turb.max_geom_lscale. auto: 100 m, GUST's default (1e6 with drive: couette): over a 40 H fetch a 30 m cap
#       # lets the near-ground wind fall 12 %, 100 m holds it within 4 % (Tests/Real_Terrain/RUSHIL/README.md).
#       # Accepts a number > 0, or auto.
#
#   tke_floor: 1.0e-06    # [m2/s2]
#       # turb.tke_floor; 0 is machine epsilon. Accepts 0, or a number ≥ 2.22045e-16.


##==================================================================================================================
## solver: The steady iteration.
##==================================================================================================================
#
# solver:
#   max_iterations: 20000
#       # steady.max_iterations. Accepts an integer ≥ 1.
#
#   residual_tolerance:    # none
#       # steady.residual_tol (GUST's default 5e-5). Accepts a number > 0.
#
#   residual_drop_orders:    # none
#       # steady.residual_drop_orders (GUST's default 4). Accepts a number ≥ 0 and ≤ 308.
#
#   cfl_max: 16
#       # steady.cfl_max; at least steady.cfl0 (GUST's default 1, not written). Accepts a number ≥ 1.
#
#   sweep: lusgs
#       # steady.sweep: lusgs (CPU), zjacobi (also GPU) or auto (GUST chooses by its build). Accepts lusgs, zjacobi,
#       # auto.
#
#   grid_sequencing:    # none
#       # Start on the coarse levels (steady.sequencing). Default: on with two or more hierarchy levels. Accepts
#       # true or false.
#
#   w_vnn_cap: 16
#       # simplec.w_vnn_cap; 0 switches the cap off. Accepts 0, or a number ≥ 16.
#
#   initial_blend: [1, 0.5]
#       # init.alpha_h and init.alpha_v of the mass-consistent first guess. Accepts 2 numbers > 0.


##==================================================================================================================
## output: Plotfiles and checkpoints.
##==================================================================================================================
#
# output:
#   prefix: ""
#       # Prefix of the plotfile and checkpoint names (prefix_plt, ...). Accepts text.
#
#   turbulence_plotfile: true
#       # Write the turbulence plotfile (io.turb_plot_file). Accepts true or false.
#
#   checkpoint: false
#       # Write checkpoints. Always on with nests: a patch reads its parent's. Accepts true or false.


##==================================================================================================================
## run: The run script.
##==================================================================================================================
#
# run:
#   ranks: 1
#       # MPI ranks of the run script (run.sh uses run.mpi_launcher even for 1; the window runs gust alone). Accepts
#       # an integer ≥ 1.
#
#   executable: gust
#       # The GUST executable: a name on PATH or a path. run.sh runs it from each step's folder (column/, nest_*/
#       # are one deeper), so give an absolute path there; the case set-up window takes a relative path from the
#       # case file's folder. Accepts text.
#
#   mpi_launcher: mpiexec -n {ranks}
#       # The MPI command; {ranks} is replaced. Accepts text.


##==================================================================================================================
## nests: Nested patches.
##==================================================================================================================
#
# nests:
#   - name:    # required
#         # Name of the patch; its folder is nest_<name>. Accepts text.
#
#     center:    # none [m]
#         # Centre of the patch, as domain.center. Accepts 2 numbers.
#
#     center_lat_lon:    # none [degrees]
#         # Centre of the patch as latitude, longitude. Accepts 2 numbers.
#
#     half_width:    # required [m]
#         # Distance from the centre to the patch's faces (one or two numbers). The faces are moved to the parent's
#         # nearest cell faces. Accepts a list of numbers > 0.
#
#     blend_width: auto    # [m]
#         # terrain.nest_blend_width. auto: 4 parent cells. Accepts a number ≥ 0, or auto.
#
#     max_iterations:    # none
#         # steady.max_iterations of the patch. Default: solver.max_iterations. Accepts an integer ≥ 1.


##==================================================================================================================
## gust_inputs: Any other GUST input.
##==================================================================================================================
#
# gust_inputs:    # none
#     # GUST inputs written as they are (namespace.key: value) after everything else: a key the builder also writes
#     # is replaced, and null removes one. They go to the 3-D decks (the run folder's and each patch's), not to
#     # column/inputs, the 1-D column run with its own mesh and keys. Accepts see the text.
