# The building geometry from an ERF-format height map (buildings.file is given
# on the command line, from this folder): no stage, so the run writes the
# plotfile (with building_beta and building_wall) and a checkpoint (with the
# buildings' input hash). 32 x 24 x 20 cells, 8 x 8 boxes; a stretched grid, so
# roofs fall inside cells; periodic in x, so one block crosses the seam.
mesh.n_cell        = 32 24 20
mesh.prob_lo       = 0. 0. 0.
mesh.prob_hi       = 640. 480. 400.
mesh.is_periodic   = 1 0 0
mesh.max_grid_size = 8
mesh.dz0           = 1.
mesh.stretch_ratio = 1.12

buildings.type = immersed_forcing
buildings.small_volfrac = 0

io.plot_file = buildings_plt
io.chk_file  = buildings_chk
