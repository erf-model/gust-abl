# A flat doubly periodic column with a geostrophic wind, for the named set-ups
# (Source/AblSetup.H). The deck sets everything but forcing.coriolis and
# forcing.geostrophic: the test gives them either by hand or through
# abl.drive = geostrophic_column, and compares the two runs bit for bit. A few
# iterations are enough, because the runs must match at every step.
mesh.n_cell        = 4 4 32
mesh.prob_hi       = 2560. 2560. 2000.
mesh.is_periodic   = 1 1 0
mesh.max_grid_size = 2 4

terrain.type = flat

bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0 = 0.1
bc.theta_profile_z = 0.
bc.theta_profile   = 300.

init.first_guess = column

forcing.latitude = 45.
forcing.ug       = 10.
forcing.vg       = 0.

steady.stage          = simplec
steady.sweep          = zjacobi
steady.cfl0           = 1.
steady.cfl_max        = 50.
steady.max_iterations = 20

io.plot_file      = abl_column_plt
io.turb_plot_file = abl_column_turb
io.chk_file       = abl_column_chk
