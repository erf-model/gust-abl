# GUST master input reference (all inputs, with defaults, ranges and meaning).
#
# Generated from docs/inputs.rst by tools/input_reference.py --write; do not
# edit by hand. The CTest input_reference_current checks that this file, the
# docs and the keys read in Source/ agree.
#
# Every line is a comment. Copy the key lines you need into a deck, remove the
# leading "# " and set the values. A key line reads "# namespace.key = default",
# with a note after it where the default has a unit or a condition;
# "# required" means the key has no default, "# none" that it is off or empty
# unless given. The indented text below each key is its range and meaning. A key
# that has no effect with the other inputs is refused, as are unknown and
# repeated keys (docs/inputs.rst). Units are SI (m, s, K) unless the text says
# otherwise.


# ==================================================================================================================
# mesh
# ==================================================================================================================
#
# mesh.n_cell =    # required
#     Three integers ≥ 1: cells in x, y and z.
#
# mesh.prob_lo = 0 0 0
#     Three finite values: the low corner of the domain (m). The z value must be 0.
#
# mesh.prob_hi =    # required
#     Three finite values, each greater than prob_lo: the high corner of the domain (m).
#
# mesh.is_periodic = 0 0 0
#     Three values, each 0 or 1. z must be 0.
#
# mesh.max_grid_size = 64
#     One or two integers ≥ 1: the largest box size in x and y. Boxes are never split in z.
#
# mesh.dz0 = 0
#     Finite, ≥ 0 (m). First layer thickness of a stretched grid; 0 gives uniform layers. Without mesh.stretch_ratio
#     it must not exceed prob_hi z / n_cell z (docs/terrain_coordinates.rst).
#
# mesh.stretch_ratio =    # none
#     Finite, ≥ 1; needs mesh.dz0 > 0. A fixed ratio between successive layers; the top is then where the layers
#     end, and prob_hi z only sets the computational spacing.
#
# mesh.zlevels_file =    # none
#     A file of n_cell z + 1 increasing heights starting at 0. Not together with mesh.dz0.
#
# mesh.hierarchy_levels = 1
#     Integer from 1 to 10: the levels L of the grid hierarchy (docs/grid_hierarchy.rst). With L > 1, n_cell and
#     max_grid_size in x and y must be divisible by 2^(L-1), and the coarsest level must be larger than 1 × 1 cells.
#     The box layout of level 0 can then differ from L = 1, which changes results in the last bits. The solver uses
#     the coarse levels only with steady.sequencing = 1. May change across a restart.

# ==================================================================================================================
# terrain
# ==================================================================================================================
#
# terrain.type = flat
#     flat, agnesi (analytic hill), xyz (point cloud) or erf_grid (ERF's terrain file)
#     (docs/terrain_coordinates.rst).
#
# terrain.file =    # required for xyz, erf_grid
#     The point file (x y z per line) or ERF's structured terrain file.
#
# terrain.smoothing = 1
#     0 (BTF), 1 (STF) or 2 (Sullivan). 1 is refused with nest.names over terrain other than flat.
#
# terrain.gamma_m = 0.5
#     > 0 and < 1; STF only. Smallest layer thickness as a fraction of the flat layer.
#
# terrain.hill_height =    # required for agnesi
#     Finite, > 0 (m).
#
# terrain.hill_half_width =    # required for agnesi
#     Finite, > 0 (m). Distance from the crest at which the hill is half as high. The hill is centred on the domain;
#     in a patch (bc.nest_parent) and a nest, on the parent's domain.
#
# terrain.hill_shape = ridge_x
#     ridge_x (a ridge along y, varying in x), ridge_y or round; agnesi only.
#
# terrain.idw_neighbors = 6
#     ≥ 1; xyz, bc.surface_z0_file or canopy.type = map only. Points used for each height (and each column's z_0 of
#     the roughness map, and the canopy's maps).
#
# terrain.idw_power = 2
#     Finite, > 0; xyz, bc.surface_z0_file or canopy.type = map only. Weight exponent p in d^(-p).
#
# terrain.hierarchy_passes = 1
#     Integer from 0 to 64; only with mesh.hierarchy_levels > 1. The ground of level l is smoothed by this number
#     times (2^l - 1) passes (docs/grid_hierarchy.rst).
#
# terrain.nest_blend_width = 0
#     Finite, ≥ 0 (m), below half the patch's width across its nest faces; 0: off. Refused without a nest face. The
#     patch's ground becomes the parent's on the nest faces and its own from this distance inwards, with a
#     smoothstep between (docs/boundary_conditions.rst).
#
# terrain.representation = body_fitted
#     body_fitted (the mesh follows the ground), immersed_forcing (the mesh is flat and the ground is an immersed
#     surface with the form 7 wall law, docs/immersed_terrain.rst) or hybrid (the mesh follows a smoothed lower
#     envelope of the ground and the ground is immersed in it, docs/immersed_terrain.rst, Hybrid mesh). hybrid has
#     the refusals of immersed_forcing except terrain.smoothing and terrain.gamma_m, which shape its mesh aloft as
#     on a body-fitted mesh. immersed_forcing needs mesh.hierarchy_levels = 1, bc.zlo = surface_layer,
#     bc.surface_stability = neutral, bc.surface_wall_k = dirichlet, turb.closure = kl and, in a stage, steady.sweep
#     = zjacobi. It refuses bc.surface_zref, bc.surface_denominator_floor, a non-uniform bc.theta_profile,
#     buildings.type, canopy.heat = fixed, nests, init.first_guess = column, steady.probes_file, steady.stage =
#     simplec_newton and unsteady, solver.poisson_backend = mlmg (in a stage), and terrain.smoothing,
#     terrain.gamma_m, terrain.hierarchy_passes and terrain.nest_blend_width when given. The refusals apply to a run
#     with no stage too. May not change across a restart.
#
# terrain.flat_height =    # required for immersed_forcing; hybrid: the first layer's thickness
#     Finite (m); immersed_forcing: between the top of the mesh's first layer and the bottom of its top layer;
#     hybrid: ≥ 0 and at most the bottom of its top layer. immersed_forcing and hybrid only. The height of the
#     terrain's zero level above the mesh's lower face (z = 0): the ground is terrain.flat_height plus the height
#     terrain.type gives (the ground itself with flat), and the whole ground must lie between the same two levels.
#     Cells below it are solid. With hybrid the mesh's lower face follows the envelope, so the gap between it and
#     the ground is at least terrain.flat_height, and the ground must lie at or below the bottom of each column's
#     top layer. With hybrid and 0 the lower face is the ground where the envelope meets the terrain, and the
#     surface layer acts there (docs/immersed_terrain.rst, Hybrid mesh). With hybrid and the key not given, the
#     thickness of the mesh's first layer (its first z-level). May not change across a restart.
#
# terrain.hybrid_half_width =    # two cells (2 max(dx, dy))
#     Finite, ≥ 0 and at most the domain's larger lateral length (m); hybrid only (refused when given otherwise).
#     The mesh's lower face is the running minimum of the terrain's height over a square of this half-width, then
#     the running mean of that over the same square, never above the terrain. The square is floor(width / dx) nodes
#     in x and floor(width / dy) in y, cut at faces that are not periodic. 0: the mesh follows the terrain itself,
#     with the ground terrain.flat_height above its lower face. A larger width gives a smoother mesh and a larger
#     gap (docs/immersed_terrain.rst, Hybrid mesh). Not given: twice the larger of dx and dy, counting only a
#     direction with more than one cell (tools/hybrid_width.py suggests a range for a terrain). May not change
#     across a restart.
#
# terrain.small_volfrac = 0.005
#     ≥ 1e-4 and < 0.5; immersed_forcing and hybrid only. A solid fraction below it becomes 0 and one within it of 1
#     becomes 1, as with buildings.small_volfrac, so it still decides which cells are solid. Unlike
#     buildings.small_volfrac it is not a tolerance of the wall-cell test: every cell that is not solid and whose
#     low z face is more blocked than its high one is a wall cell. May not change across a restart.

# ==================================================================================================================
# init
# ==================================================================================================================
# See docs/initial_conditions.rst. The keys other than init.first_guess are refused with init.first_guess = none. A
# restart cannot be combined with init.* keys.
#
# init.first_guess = none
#     none (fluid at rest), profile (the inflow profile by height above the ground) or column (the steady
#     single-column profile; needs a horizontal forcing and steady.stage = simplec or simplec_newton, and with a
#     canopy flat terrain and a canopy that is the same in every column; see docs/initial_conditions.rst for the
#     full list) or nest (a parent run's checkpoint, bc.nest_parent, interpolated at r r 1, r = bc.nest_ratio; not
#     with steady.sequencing = 1; see docs/initial_conditions.rst).
#
# init.projection = 1
#     0 or 1: the mass-consistent adjustment. With 0, init.alpha_h and init.alpha_v are refused.
#
# init.alpha_h = 1
#     Finite, > 0. Horizontal transmissivity α_h.
#
# init.alpha_v = 1
#     Finite, > 0. Vertical transmissivity α_v. Only α_v/α_h matters. Ratios below 0.1 need more than the default
#     solver.poisson_max_iter. With α_v ≠ α_h the adjustment uses the gmres_fft back end.
#
# init.z_agl_min = 0
#     Finite, ≥ 0 (m). Lowest height above the ground at which the profile is evaluated. Not with nest.
#
# init.k_decay_height = 0
#     Finite, ≥ 0 (m). Height z_i above which the initial k decays; 0: no decay. Not with column or nest.
#
# init.obrien = 0
#     0 or 1. The O'Brien correction of the vertical velocity before the adjustment. Not with nest.
#
# init.column_tol = 1e-8
#     Finite, > 0; column only. Convergence tolerance of the single-column solve: the largest relative change of u,
#     v, k (and of θ where the column solves it) over a step. Raised to at least 100 machine epsilon (1.2e-5 single,
#     2.2e-14 double).
#
# init.column_max_iterations = 5000
#     ≥ 1; column only. The run stops if a column has not converged after this many steps. The limit applies to each
#     column solved: the surface search and the target wind solve several (the log gives the total).
#
# init.column_stability = mol
#     mol, heat_flux or surface_temperature; column only. How the column's surface sets θ (stratified column,
#     docs/initial_conditions.rst). heat_flux takes bc.surface_heat_flux and needs bc.surface_stability = heat_flux.
#     Any non-neutral surface needs forcing.gravity > 0 and, in the steady column, a Rayleigh layer on θ
#     (bc.rayleigh_zdamp > 0, theta in bc.rayleigh_fields).
#
# init.column_mol = 0
#     0 (neutral: θ held at the sounding, the column before this input) or finite with |L| ≥ 1 (m); mol only. The
#     Obukhov length L (> 0 stable, < 0 unstable). With bc.surface_stability = heat_flux the 3-D run takes the
#     column's flux (bc.surface_heat_flux is then refused).
#
# init.column_surface_theta = 0
#     Finite, ≥ 0; > 0 (K) and required with surface_temperature, and given only there: the surface potential
#     temperature.
#
# init.column_target_u = 0
# init.column_target_v = 0
#     Finite (m/s); column only. A target wind at init.column_target_height: the geostrophic wind and the column's
#     Rayleigh reference wind are turned and scaled by the ratio of the target to the column's wind there, the
#     pressure gradient by that ratio times its magnitude, until they agree to 1e-4; the run then uses that forcing.
#     Both 0: off (giving them as 0 is refused). Refused with what would hold the 3-D wind to the deck's inflow
#     profile: a Rayleigh layer on u and v, a sponge or an inflow face (the sponge and the inflow face are accepted
#     with bc.inflow_profile = column, which makes them take the target column); and with a stratified column unless
#     bc.surface_stability = heat_flux.
#
# init.column_target_height = 0
#     Finite, > 0 (m) with a target wind, and only then: its height above the ground, at most the top cell centre.
#     Below the first cell centre the wind is MOST's profile; above, linear in ln(z + z_0) between centres.
#
# init.column_rib_max = 4
#     Finite, > 0; a stratified column only. The upper bound of the bulk Richardson number of the column's surface
#     solve (ERF's value). With Businger–Dyer's stable functions the bound used is min(init.column_rib_max, 0.19),
#     below their 0.2 limit (stratified column, docs/initial_conditions.rst).
#
# init.column_rib_min = -4
#     Finite, < 0; a stratified column only. The lower bound (ERF's value). Both bounds are refused with
#     init.column_time > 0 and heat_flux (the flux is given; no bulk Richardson number is solved).
#
# init.column_time = 0
#     Finite, ≥ 0 (s); column only. 0: the steady column. > 0: the time-marching column (time-marching column,
#     docs/initial_conditions.rst), backward Euler steps of init.column_dt in physical time to this time; the table
#     is the column at that time. Refused with init.column_tol, init.column_max_iterations, a target wind and a
#     non-zero init.column_mol.
#
# init.column_dt = 1
#     Finite, > 0 (s); with init.column_time > 0 only. The step; the last step ends at init.column_time.
#     init.column_time / init.column_dt must be at most 1e7 steps.
#
# init.column_wall_k = fixed
#     fixed or solved; with init.column_time > 0 only. fixed: the first cell's k is the surface layer's wall value,
#     as in the steady column and the 3-D run. solved: the first cell's k is solved with the k equation of the other
#     cells and no k flux through the ground (time-marching column, docs/initial_conditions.rst).
#
# init.column_z0 =    # none
#     Finite, > 0 (m); column only. The roughness length of the column when bc.surface_z0_file gives the 3-D run a
#     roughness map: required then, since the column has one surface. Refused without bc.surface_z0_file (the column
#     then takes bc.surface_z0). The 3-D run keeps the map; the column only seeds the first guess (and, with
#     init.column_target_u/_v, the adjusted forcing). A value near the map's upstream roughness keeps the first
#     guess close to the flow that arrives at the domain.

# ==================================================================================================================
# bc
# ==================================================================================================================
# See docs/boundary_conditions.rst. Read when init.first_guess is not none or with the SIMPLEC stage; refused
# otherwise. A key that has no effect for the chosen boundary types is refused. The initial field uses the boundary
# types, the inflow profile and the sounding; the other keys act in the SIMPLEC stage.
#
# The wall model and the inflow profile's equilibrium k and ν_t use the turbulence model's turb.Cmu0 and turb.kappa,
# and the inflow profile its turb.max_geom_lscale. Without the SIMPLEC stage (turb.* is then refused) they use the
# defaults, 0.5562, 0.41 and 100 m.
#
# bc.xlo = periodic
# bc.xhi = periodic
# bc.ylo = periodic
# bc.yhi = periodic
#     periodic exactly when mesh.is_periodic is 1 in that direction; otherwise inflow, outflow, slip_wall,
#     no_slip_wall or nest (the parent run's field on the face of a nested patch, docs/boundary_conditions.rst).
#     nest needs bc.nest_parent and init.first_guess = nest or io.restart; it is refused with steady.sequencing = 1,
#     with a slip_wall or no_slip_wall lateral face, with buildings, and with an inflow face unless there is an
#     outflow face too.
#
# bc.zlo = surface_layer
#     surface_layer, slip_wall or no_slip_wall (nest is for the lateral faces only).
#
# bc.zhi = slip_wall
#     slip_wall, no_slip_wall or geostrophic (needs Coriolis with geostrophic forcing).
#
# bc.xlo_wall_velocity = 0 0 0
# bc.xhi_wall_velocity = 0 0 0
# bc.ylo_wall_velocity = 0 0 0
# bc.yhi_wall_velocity = 0 0 0
# bc.zlo_wall_velocity = 0 0 0
# bc.zhi_wall_velocity = 0 0 0
#     Three finite values (m/s): the velocity of a no_slip_wall face (<face> is xlo … zhi). The normal component
#     must be 0.
#
# bc.inflow_profile = log_law
#     log_law, power_law, file or column. The inflow keys need an inflow face, a damping layer, init.first_guess =
#     profile or column, or a restart. column: the inflow faces, the side sponge and the θ Rayleigh layer take the
#     run's own converged column (init.first_guess = column), and the run keeps the forcing of its target wind (the
#     run's own column, docs/boundary_conditions.rst). It needs init.first_guess = column (or io.restart: the
#     checkpoint holds the column and its forcing) and an inflow face. Refused with bc.inflow_z0 (the faces take the
#     column's roughness: init.column_z0 under a map, else bc.surface_z0), bc.inflow_tke_length (the column has k),
#     bc.inflow_direction, bc.inflow_file, the other analytic keys, a Rayleigh layer on u, v or tke, and nest.names.
#     Accepted with abl.drive = geostrophic_column and abl.theta = frozen. A restart refuses a checkpoint written
#     with another kind, and the other kinds refuse a checkpoint written with column. On a restart, the record's
#     forcing replaces the deck's when the column had a target wind; otherwise the deck's forcing.ug, forcing.vg and
#     forcing.pressure_gradient must equal the record's.
#
# bc.inflow_ustar = 0.4    # m/s
#     Finite, > 0; log_law only.
#
# bc.inflow_z0 = 0.1    # m
#     Finite, > 0. Roughness of the log law, and of the equilibrium k of every profile type. Normally equal to
#     bc.surface_z0.
#
# bc.inflow_speed = 10    # m/s
# bc.inflow_zref = 10    # m
# bc.inflow_alpha = 0.14
#     power_law only. Speed finite and ≥ 0; height and exponent finite and > 0.
#
# bc.inflow_direction = 0
#     Finite (degrees). The direction the wind blows towards, counter-clockwise from the x axis. log_law and
#     power_law only; refused with file, whose profile gives u and v itself.
#
# bc.inflow_file =    # none
#     Required with file: rows of z u v theta [k] (4 or 5 columns, at least 2 rows), z increasing from 0, θ > 0, k ≥
#     0. # starts a comment. Every token must be a complete number with nothing attached (300.0K, 1.0D+00 or 1,2
#     stops the run with the file and line named); a UTF-8 byte-order mark is skipped. Read on the I/O rank and
#     broadcast.
#
# bc.inflow_tke_length = closure
#     closure or unbounded: the length l of the equilibrium k and ν_t (docs/boundary_conditions.rst). closure: the
#     turbulence model's κ(z + z_0) capped by turb.max_geom_lscale. unbounded: κ(z + z_0), the form before this
#     input (for the log law, k = u_*^2/C_μ0^2 at every height). Refused with a k column in bc.inflow_file (no
#     effect). A checkpoint written before this input continues unchanged only with unbounded: the inflow k is not
#     stored in the checkpoint.
#
# bc.theta_profile_z = 0
# bc.theta_profile = 300
#     Lists of equal length: finite, strictly increasing heights (m) and θ > 0 (K). The reference sounding.
#
# bc.zhi_theta_grad = 0
#     Finite (K/m): θ gradient through a slip_wall or geostrophic top.
#
# bc.rayleigh_zdamp = 0    # off
#     In [0, top level): start height of the Rayleigh layer (m); > 0 needs bc.rayleigh_dampcoef > 0. The top level
#     is mesh.prob_hi z, or where the layers end with mesh.stretch_ratio or mesh.zlevels_file. With
#     terrain.representation = immersed_forcing or hybrid and absolute heights the limit is the top level minus
#     terrain.flat_height, since heights are measured from the terrain's zero.
#
# bc.rayleigh_dampcoef = 0
#     Finite, ≥ 0 (1/s); needs bc.rayleigh_zdamp > 0.
#
# bc.rayleigh_fields = u v w theta tke
#     One or more of u v w theta tke; needs bc.rayleigh_zdamp > 0. With a nest face and no inflow face only w and
#     theta (u, v and k relax towards the bc.inflow_* profile, not the parent). The nests of nest.names damp w and
#     theta only unless nest.damping = outer, which keeps this list in the nests too.
#
# bc.rayleigh_height = absolute
#     absolute or above_ground: the height used for the layer's coefficient and for θ's reference (u, v, k always
#     use the height above the ground). absolute is measured from the terrain's zero: on an immersed ground
#     (terrain.representation = immersed_forcing or hybrid) that is terrain.flat_height above the mesh's lower face.
#
# bc.sponge_width = 0    # off
#     Finite, ≥ 0 (m); > 0 needs an inflow or outflow face and bc.sponge_strength > 0. Refused with a nest face and
#     no inflow face.
#
# bc.sponge_strength = 0
#     Finite, ≥ 0 (1/s); needs bc.sponge_width > 0.
#
# bc.outflow_transport = mirror
#     mirror or from_velocity; needs an outflow face. mirror: each ghost cell outside an outflow face has the
#     transport fluxes of the cell inside it, mirrored through the face (the normal flux continued linearly through
#     its face value), so it has that cell's divergence. from_velocity: the fluxes are computed from the ghost
#     cells' copied velocities and their own geometry, the only choice up to v1.0.0. The velocity ghosts are the
#     same either way (docs/boundary_conditions.rst). from_velocity is refused with terrain.representation =
#     immersed_forcing.
#
# bc.surface_z0 = 0.1    # m
#     Finite, > 0. Roughness length of the wall model. The bc.surface_* keys need bc.zlo = surface_layer.
#
# bc.surface_z0_file =    # none (bc.surface_z0)
#     A file of x y z0 points (terrain.file's format), interpolated to the ground columns in ln z_0 with
#     terrain.idw_neighbors and terrain.idw_power (roughness map, docs/boundary_conditions.rst). Not with
#     bc.surface_z0 (both given aborts). With init.first_guess = column it needs init.column_z0, the column's one
#     roughness. Every value finite and > 0, at least terrain.idw_neighbors points, and the file readable, or the
#     run aborts naming the key. bc.inflow_z0 stays the inflow's roughness.
#
# bc.surface_zref = 0
#     Finite. ≤ 0: each column's first cell centre. Otherwise a height between the first and last cell-centre
#     heights of every column (m).
#
# bc.surface_stability = neutral
#     neutral or heat_flux.
#
# bc.surface_heat_flux = 0
#     Finite (K m/s); heat_flux only.
#
# bc.surface_wall_k = dirichlet
#     dirichlet or source.
#
# bc.surface_denominator_floor = log_law
#     log_law (m = min(ln((d + z_0)/z_0), 1)) or one (m = 1): the floor of the MOST denominator. They differ only
#     where ln((d + z_0)/z_0) < 1.
#
# bc.surface_stable_functions = businger_dyer
#     businger_dyer or qnse: the stable side (z/L > 0) of φ_m, φ_h, ψ_m, ψ_h (stable functions,
#     docs/boundary_conditions.rst), for the wall model and the column. qnse needs bc.surface_stability = heat_flux
#     or a stratified column (init.column_stability), otherwise the run stops.
#
# bc.surface_qnse_am = 2.5
# bc.surface_qnse_bm = 0.2
#     a_m, b_m of φ_m = (1 + a_m ζ)/(1 + b_m ζ): b_m > 0, a_m ≥ b_m, finite. qnse only (otherwise the run stops).
#
# bc.surface_qnse_ah = 2.5
# bc.surface_qnse_bh = 0.2
#     a_h, b_h of φ_h, as a_m, b_m. qnse only.
#
# bc.nest_parent =    # none
#     A checkpoint directory of the parent run, written by this version (checkpoint format 2, which holds the
#     z-levels); required with init.first_guess = nest or a nest face and refused without both (no effect). The
#     patch must refine the parent by bc.nest_ratio in x and y and 1 in z, lie on the parent's cell faces (to
#     10^(-4) of a parent cell), keep 2 parent cells from every non-periodic face of the parent (it may reach a
#     periodic face), span the full width of a direction in which it is periodic (mesh.prob_lo and mesh.prob_hi
#     equal to the parent's there), and have the parent's z-levels bit for bit (mesh.n_cell z, mesh.prob_lo z,
#     mesh.prob_hi z, mesh.dz0, mesh.stretch_ratio, mesh.zlevels_file). Any other placement, a directory without a
#     checkpoint Header or a format-1 checkpoint stops the run, naming this key (docs/initial_conditions.rst).
#
# bc.nest_relax_width = 0
#     Integer ≥ 0 (cells), below half the patch's cells across its nest faces; 0: no zone. Refused without a nest
#     face. The number of cells inside each nest face over which u, v, w, θ and k are relaxed towards the parent's
#     field where the parent's flow enters. A robustness setting: it holds the patch to the parent's coarser
#     solution over the zone (docs/boundary_conditions.rst).
#
# bc.nest_relax_factor = 1
#     Finite, > 0. Multiplies the zone's rate; with 1 the rate at the face is the parent's inward velocity over the
#     zone's width. About e^(-f/2) of a difference from the parent passes the zone (61 % with 1, 0.7 % with 10).
#     Refused without bc.nest_relax_width > 0.
#
# bc.nest_ratio = 2
#     2, 4, 8 or 16 (any other value stops the run, naming this key). The patch's refinement of the parent in x and
#     y: its mesh.n_cell x and y are this many times the parent cells it spans, so its cells are the parent's
#     divided by it; z is not refined. Refused without bc.nest_parent (no effect). A larger ratio in one step and a
#     chain of ratio-2 patches give close results (docs/boundary_conditions.rst).

# ==================================================================================================================
# canopy
# ==================================================================================================================
# See docs/canopy.rst. The canopy's drag field is built in every run (with or without steady.stage) and written to
# the plotfile as canopy_drag; its drag acts on the momentum equations and, with canopy.tke, on the k–L closure. A
# key that has no effect with the chosen canopy.type, canopy.profile or canopy.tke is refused. A restart refuses a
# canopy geometry other than that of the run it continues (canopy.type and the keys that build the drag field);
# canopy.drag_diagonal, the closure's canopy terms (canopy.tke, canopy.beta_p, canopy.beta_d, canopy.length_alpha)
# and the leaf heat (canopy.heat, canopy.leaf_theta; canopy.heat_frozen needs frozen θ, which does not restart) may
# change across a restart, as the turb.* inputs may (the closure's inputs then change the answer, not only the path;
# a checkpoint of fully frozen closure decisions keeps canopy.length_alpha, docs/canopy.rst).
#
# canopy.type = none
#     none, patches (round patches from ERF's forest file) or map (point maps of height, LAI and optionally C_d,
#     interpolated with terrain.idw_neighbors and terrain.idw_power).
#
# canopy.file =    # required for patches
#     A readable file of patches, one per line, type x y height diameter cd lai laimax (ERF's erf.forest_file); #
#     starts a comment. type 1 or 2 (uniform or Lalic–Mihailovic), height and diameter finite and > 0 (m), cd and
#     lai finite and ≥ 0, laimax in [0, 1) on a type 2 line and finite on a type 1 line. Any other line stops the
#     run, naming the file and the line. A patch wider than a periodic direction of the domain is refused.
#
# canopy.height_file =    # required for map
#     A readable file of x y h points (terrain.file's xyz format): the canopy height (m), every value finite and ≥
#     0, at least terrain.idw_neighbors points.
#
# canopy.lai_file =    # required for map
#     A readable file of x y LAI points: the leaf area index, every value finite and ≥ 0, at least
#     terrain.idw_neighbors points.
#
# canopy.cd =    # none
#     Finite, > 0; map only. The drag coefficient of every column. map needs this or canopy.cd_file, not both (no
#     default, as in ERF). 0 is refused: without a canopy, set canopy.type = none. The maps, by contrast, may hold 0
#     where there is no forest.
#
# canopy.cd_file =    # none
#     map only. A readable file of x y cd points, every value finite and ≥ 0, at least terrain.idw_neighbors points.
#
# canopy.profile = uniform
#     uniform or lalic_mihailovic; map only. The shape of the leaf area density over the canopy height.
#
# canopy.laimax = 0.8
#     Finite, in [0, 1); map with lalic_mihailovic only. The height of the largest leaf area density as a fraction
#     of the canopy height (ERF's erf.forest_laimax).
#
# canopy.drag_diagonal = derivative
#     derivative, picard or none; patches or map. The drag's term on the diagonal of the momentum rows: the exact
#     derivative f_c(|U| + u_c^2/|U|), f_c|U| with |U| frozen, or nothing (the drag explicit, as in ERF). The
#     converged answer does not depend on it; the iterations do. May change across a restart.
#
# canopy.tke = on
#     on or off; patches or map. The canopy terms of the k–L closure (docs/canopy.rst): the wake production β_p f
#     |U|^3, the short-circuit sink β_d f |U| k and the length cap L ≤ α/f. off keeps the drag only.
#
# canopy.beta_p = 1
#     Finite, in [0, 1]; canopy.tke = on only. The fraction of the drag work f|U|^3 that becomes k (ERF's
#     erf.forest_canopy_beta_p).
#
# canopy.beta_d = 4
#     Finite, ≥ 0; canopy.tke = on only. The short-circuit coefficient of the sink β_d f |U| k (ERF's
#     erf.forest_canopy_beta_d).
#
# canopy.length_alpha = 0.04
#     Finite, in [0, 1]; canopy.tke = on only. The cap L ≤ α/f on the turbulent length; 0 turns the cap off and
#     keeps the sources (ERF's erf.forest_canopy_length_alpha). canopy.beta_p, canopy.beta_d and canopy.length_alpha
#     all 0 with canopy.tke = on is refused (it changes nothing).
#
# canopy.heat = off
#     off or fixed; patches or map. The leaves' sensible heat exchange with the air at a fixed leaf temperature
#     (docs/canopy.rst): θ gains λ(θ_l - θ), λ = 2a/r_b. off leaves θ as without it, bit for bit. fixed is refused
#     with terrain.representation = immersed_forcing or hybrid.
#
# canopy.leaf_theta =    # none
#     In [150, 400] (K: a value in °C is refused); required with canopy.heat = fixed and refused otherwise. The
#     leaves' potential temperature θ_l (ERF's erf.forest_leaf_theta_fixed); "fixed" names this fixed leaf
#     temperature.
#
# canopy.heat_frozen = skip
#     skip or blend; canopy.heat = fixed with simplec.theta = frozen only (refused otherwise). skip: the leaf heat
#     is left out, with a warning. blend: in the canopy θ is set each iteration to θ_f + w(θ_l - θ_f), w = λ k/(ε +
#     λ k), from the frozen θ_f (docs/canopy.rst). blend is refused with nest.names and with init.first_guess =
#     nest: a nest or a patch would blend the outer domain's or the parent run's θ again.

# ==================================================================================================================
# buildings
# ==================================================================================================================
# See docs/buildings.rst. The geometry is built in a run without steady.stage and written to the plotfile as
# building_beta and building_wall. With a stage it acts on momentum: SIMPLEC, z-line sweeps, one level, and
# solver.poisson_backend other than mlmg; others are refused. It acts on the closure too (buildings.wall_tke) and on
# theta (buildings.theta_mode). A key that has no effect with buildings.type = none is refused. A restart refuses
# buildings other than those of the run it continues.
#
# buildings.type = none
#     none or immersed_forcing. Refused with nest.names; a patch with nest faces keeps its buildings clear of them.
#
# buildings.file =    # required when on
#     The height map, readable. Heights above the local ground (m), finite and ≥ 0. At least one building in the
#     domain, none reaching the top layer, and in a periodic direction the map no wider than the domain.
#
# buildings.format = erf
#     erf: nx, ny, the x values, the y values, the heights with x the slow index. xyz: x y height or x y height
#     zstart lines holding each point of a rectangular grid once, in any order; solid from zstart (≥ 0, and below
#     height where height > 0; default 0) to height.
#
# buildings.force_file =    # none
#     A file name, not empty: the CSV t,Fx,Fy,Fz of the force on the buildings per unit density (m⁴/s²), from the
#     momentum residual over their blocked faces (docs/buildings.rst, Force on the buildings). One row after a
#     steady solve; with steady.stage = unsteady one at the start and one per step, and a restart keeps the rows up
#     to the checkpoint's time. Needs steady.stage.
#
# buildings.small_volfrac = 0.005
#     In [0, 0.5). Below it a fraction is 0, within it of 1 the fraction is 1. At 0, round-off alone is clipped. A
#     cell is a wall cell only where the blocked parts of two opposite faces differ by more than it.
#
# buildings.z0 = 0.1
#     Finite and > 0 (m). Refused with buildings.wall_form = drag. The law reads distances below 10 z0 as 10 z0
#     (docs/buildings.rst, Limits). With buildings.wall_tke = on it is also the roughness in the closure's length
#     beside a wall (docs/buildings.rst, Length scale).
#
# buildings.wall_form = fraction_stress
#     fraction_stress: the form 7 wall law on roofs, undersides and sides, with the fixed rows. roof_stress: the law
#     on roofs and undersides alone, the sides with their fixed rows. drag: the fixed rows alone.
#
# buildings.wall_speed =    # open_faces with buildings.wall_form = fraction_stress, all_faces with roof_stress
#     open_faces or all_faces. open_faces: each velocity component of a wall cell's speed is the mean of its two
#     faces that are not fixed rows, so an edge or corner cell takes the open face's value. all_faces: the mean of
#     both faces, the form before. Either may be given with roof_stress. Refused with buildings.wall_form = drag (no
#     wall law). A restart from a checkpoint written before this key needs all_faces.
#
# buildings.wall_tke =    # on with buildings.wall_form = fraction_stress, else off
#     on or off. on: solid cells hold k at turb.tke_floor, wall cells relax k to u*^2 / Cmu0^2 of the wall law, k
#     does not diffuse through blocked faces, and the closure's length takes the nearer of the ground and the
#     nearest building wall, each with its own roughness. off: the closure does not see the buildings. on is refused
#     unless buildings.wall_form = fraction_stress.
#
# buildings.wall_k_bound = none
#     none or impinging. none: the wall value of k is the wall law's, max(u*^2 / Cmu0^2, turb.tke_floor). impinging:
#     it is no lower than, for each of the cell's walls, the k of the next cell out along the wall's normal times
#     the share of that cell's kinetic energy that moves towards the wall (0 where the flow leaves the wall or runs
#     along it); see docs/buildings.rst, Turbulence. Refused when given without buildings.wall_tke = on. A restart
#     with another value is refused; a checkpoint written before this key continues with none.
#
# buildings.wall_k_speed = law
#     law or cell_mean. law: the wall value of k reads the wall law's u*^2 (buildings.wall_speed). cell_mean: it
#     reads the law at the cell's root-mean-square speed, where a component with one fixed face has a third of the
#     open face's square; the stress is unchanged, and so are cells with no fixed face. Refused when given without
#     buildings.wall_tke = on, and cell_mean is refused unless buildings.wall_speed = open_faces. A restart with
#     another value is refused; a checkpoint written before this key continues with law.
#
# buildings.theta_mode =    # ambient with buildings.wall_form = fraction_stress, else none
#     none, ambient or fixed. ambient and fixed: solid cells hold theta at the walls' temperature, each wall
#     exchanges heat with its cell by the form 7 law for a given surface temperature (neutral, with the wall law's
#     u*), and theta does not diffuse through blocked faces. ambient: the walls are at the reference profile
#     (bc.theta_profile) at their height. fixed: at buildings.theta_surface. none: theta does not see the buildings.
#     ambient and fixed are refused unless buildings.wall_form = fraction_stress, and with simplec.theta = frozen
#     when given.
#
# buildings.theta_surface =    # none
#     Finite and > 0 (K). Required with buildings.theta_mode = fixed; refused otherwise.
#
# buildings.limiter_zone = 3
#     0 (off) or finite, ≥ 0.5 and ≤ 20 (building heights). With turb.realizability > 0, the eddy-viscosity cap is
#     lifted within half the zone of a building and fades back in to its edge, measured by the distance to the
#     nearest building wall in heights of that wall's building; the upwind blend, which follows the cap, fades with
#     it. When given, refused without buildings.wall_tke = on or without turb.realizability > 0; the default acts
#     only with both.

# ==================================================================================================================
# abl
# ==================================================================================================================
# See named-setups, docs/howto.rst. Read with the SIMPLEC stage only; refused otherwise. Without these keys nothing
# is checked and no default changes. A name that the deck's other inputs contradict stops the run.
#
# abl.drive =    # none
#     inflow_only, couette, pressure_driven, geostrophic_column or geostrophic_inflow.
#
# abl.theta =    # none
#     neutral, capped, frozen or surface_flux. abl.drive = couette needs neutral.

# ==================================================================================================================
# forcing
# ==================================================================================================================
# See docs/governing_equations.rst. Read with the SIMPLEC stage only.
#
# forcing.gravity = 9.81
#     Finite, ≥ 0 (m/s²). 0 switches buoyancy off.
#
# forcing.theta0 = 300
#     Finite, > 0 (K). Boussinesq reference temperature. Refused with forcing.gravity = 0.
#
# forcing.coriolis = 0
#     0 or 1: the Coriolis force.
#
# forcing.latitude = 0
#     In [−90, 90] (degrees). With coriolis = 1 only.
#
# forcing.rotation_period = 86400
#     Finite, > 0 (s); f = 4π sin φ/T. With coriolis = 1 only. The default is the solar day (ERF's value); the
#     sidereal day, 86164 s, gives an f 0.27 % larger.
#
# forcing.coriolis_3d = 1
#     0 or 1: the cos φ terms on u and w. With coriolis = 1 only.
#
# forcing.geostrophic = 0
#     0 or 1: geostrophic forcing. Needs coriolis = 1 and a non-zero latitude.
#
# forcing.ug = 0
# forcing.vg = 0
#     Finite (m/s): the geostrophic wind. With geostrophic = 1 only.
#
# forcing.pressure_gradient = 0 0 0
#     Three finite values (m/s²): a constant pressure-gradient force on u, v, w.

# ==================================================================================================================
# turb
# ==================================================================================================================
# See docs/turbulence_model.rst. Read with the SIMPLEC stage only.
#
# turb.closure = kl
#     kl or none. kl: the k-L closure (docs/turbulence_model.rst). none: laminar flow; the viscosity is
#     turb.nu_molecular (then required > 0), the heat diffusivity turb.alpha_molecular, ν_t and every closure source
#     are 0, and k is a passive scalar diffusing with turb.nu_molecular. With none only turb.nu_molecular,
#     turb.alpha_molecular and turb.tke_floor may be given (turb.face_mean has no effect on constant diffusivities),
#     and a canopy, bc.zlo = surface_layer, init.first_guess = column, steady.stage = simplec_newton,
#     buildings.wall_form other than drag and buildings.wall_tke = on are refused. May change across a restart, as
#     the other turb.* inputs: kl to none leaves the checkpoint's ν_t history unused, none to kl starts the closure
#     without one, and an unsteady restart's running averages then hold both models.
#
# turb.Cmu0 = 0.5562
#     Finite, > 0: C_μ0; also used by the wall k and the inflow profile's equilibrium k.
#
# turb.Cb = 0.35
#     Finite, > 0: C_b of the stable and unstable length scales.
#
# turb.Rt_crit = -1
#     Finite, ≤ 0: R_t is smoothed below this value.
#
# turb.Rt_min = -3
#     Finite, < turb.Rt_crit and > −3.598: the smoothed R_t stays above it. c_μ has its pole at −3.5987 and grows
#     without bound as turb.Rt_min approaches it (docs/turbulence_model.rst).
#
# turb.max_geom_lscale = 100    # m
#     Finite, > 0: the harmonic cap of l_g, approached aloft (l_g is half of it where κ (d + z_0) equals it, 244 m
#     above the ground for 100 m). Read as κ × 0.1δ, the l_g at the top of the surface layer of a boundary layer of
#     depth δ, 100 m corresponds to δ of about 2.4 km and 30 m to 0.7 km. Also the cap of the inflow profile's
#     length with bc.inflow_tke_length = closure. The default was 30 m (ERF's default) before November 2026; set
#     turb.max_geom_lscale = 30 for the earlier answers. The cap is not stored in a checkpoint: a restart reads it
#     from the deck, so a run started with the earlier default needs turb.max_geom_lscale = 30 in its deck to
#     continue the same problem. With 100 m a neutral geostrophic column without an inversion has a boundary layer
#     about 2 km deep (10 m/s, f = 1e-4 1/s): use a domain of 3 km or more, a capping inversion or bc.zhi =
#     geostrophic.
#
# turb.tke_floor = 0
#     0 (machine epsilon) or ≥ machine epsilon (m²/s²): lower bound on k.
#
# turb.sigma_k = 1
#     Finite, > 0: γ_k = ν_mol + ν_t/σ_k.
#
# turb.nu_molecular = 0
# turb.alpha_molecular = 0
#     Finite, ≥ 0 (m²/s): molecular viscosity and heat diffusivity. turb.nu_molecular > 0 with turb.closure = none.
#
# turb.kappa = 0.41
#     Finite, > 0: von Kármán constant; also used by the wall law and the inflow profile's ν_t.
#
# turb.nut_relax = 1
#     In (0, 1]: under-relaxation of ν_t (1: none).
#
# turb.nut_relax_end = 0
#     0 (off) or finite, > 0 and < 1: on each grid-sequencing level, the relaxation of turb.nut_relax ends the first
#     time the relative residual r of a SIMPLEC iteration falls below this value; from the next iteration ν_t is not
#     relaxed (nut-relax-end, docs/turbulence_model.rst). It aborts as a key with no effect with turb.nut_relax = 1,
#     and with steady.stage = unsteady.
#
# turb.frozen_switch = 1
#     0 or 1: freeze the k-floor decisions of the closure from the switch to Newton to the end of the Newton stage
#     (docs/solution_algorithm.rst). Without steady.stage = simplec_newton it aborts as a key with no effect.
#
# turb.ri_gate = 0
#     0 (off) or finite, ≥ 1e-6 and ≤ 1: Ri_0 of the stratification gate N^2 → N^2 Ri^2/(Ri^2 + Ri_0^2) in the
#     closure (docs/turbulence_model.rst).
#
# turb.realizability = 0
#     0 (off) or finite, ≥ 0.01 and ≤ 10: C_r of the cap ν_t ≤ C_r k/S, applied to the new ν_t before turb.nut_relax
#     (nut-cap, docs/turbulence_model.rst). 0.309 is about C_μ0^2 (the log-layer value) for the default turb.Cmu0.
#
# turb.face_mean = arithmetic
#     arithmetic or logarithmic (docs/discretization.rst).
#
# turb.wall_distance = terrain_height
#     terrain_height or tucker.
#
# turb.shear_stencil = central
#     central or log_law. The vertical gradients of u and v in S^2. central is the central difference, which
#     over-estimates the gradient of a log profile in the cells next to the wall cell. log_law takes (u_k+1 - u_k-1)
#     / [(d_k + z_0) ln((d_k+1 + z_0)/(d_k-1 + z_0))] in every cell above the wall cell, with d the height above the
#     ground (log-shear, docs/turbulence_model.rst); with an immersed ground it takes the place of that ground's
#     shear formula (docs/immersed_terrain.rst). It needs bc.zlo = surface_layer (bc.surface_z0 or
#     bc.surface_z0_file) and turb.wall_distance = terrain_height, and stops with buildings.type = immersed_forcing.
#     Refused with turb.closure = none.

# ==================================================================================================================
# convection
# ==================================================================================================================
# See docs/discretization.rst. Read with the SIMPLEC stage only. k always uses first-order upwinding.
#
# convection.limiter = van_leer
#     van_leer, van_albada or upwind, for momentum and θ.
#
# convection.smooth_eps_velocity = 1e-5
#     > 0 (m/s), with a finite square: the ε of van_albada for momentum.
#
# convection.smooth_eps_theta = 1e-5
#     The same for θ (K).
#
# convection.hybrid_sigma_max = 0
#     0 (off) or finite, > 0 and ≤ 1: the largest blend σ of the momentum and θ convection towards first-order
#     upwind (hybrid-convection, docs/turbulence_model.rst). Needs turb.realizability > 0; not with
#     convection.limiter = upwind, steady.stage = simplec_newton or io.restart.
#
# convection.hybrid_height =    # none
#     Finite, > 0 (m), required with hybrid_sigma_max > 0: the blend acts below this height above the ground and
#     tapers to 0 at 1.5 times it (recommended: 2.5 terrain heights).
#
# convection.hybrid_relax = 0.1
#     In (0, 1]: under-relaxation of σ per iteration. Refused unless hybrid_sigma_max > 0.
#
# convection.hybrid_freeze = 1e-2
#     0 (never) or in (0, 1): σ is frozen once the relative residual falls below it. Refused unless hybrid_sigma_max
#     > 0.

# ==================================================================================================================
# steady
# ==================================================================================================================
# See docs/solution_algorithm.rst. With steady.stage = none the application builds the mesh and initial field,
# writes them and stops; the other steady.* keys are then refused.
#
# The steady.newton_* and steady.switch_* keys are read with steady.stage = simplec_newton; with simplec they abort
# as keys with no effect. Their defaults are provisional. The last seven rows are the pseudo-transient continuation
# of docs/solution_algorithm.rst. In the Newton stage its CFL ramps from steady.cfl_max to steady.newton_cfl_max
# with the SER keys; the SER law's residual term takes steady.newton_cfl_max as its starting CFL, so
# steady.ser_exponent rarely limits the ramp there.
#
# steady.stage = none
#     none, simplec, simplec_newton or unsteady. simplec_newton: SIMPLEC, then the Newton stage once the switch
#     rules allow it, with the fallback to SIMPLEC (docs/solution_algorithm.rst). unsteady: backward-Euler physical
#     steps, each converged by SIMPLEC pseudo-time iterations (unsteady).
#
# steady.max_iterations = 10000
#     ≥ 1. Iteration limit over the whole run, restarts included. With grid sequencing it applies to each level.
#
# steady.residual_tol = 5e-5
#     Finite, > 0. Every scaled residual must be below it. The scales divide by the depth of the layers, not
#     mesh.prob_hi z (convergence-criteria, docs/solution_algorithm.rst). In a joint run with nest.feedback = defect
#     the outer domain's value also sets the size below which the source's change counts absolutely
#     (docs/boundary_conditions.rst, Two-way nests).
#
# steady.residual_drop_orders = 4
#     ≥ 0 and ≤ the largest decimal exponent of the precision (308 double, 38 single). Every residual must also drop
#     this many orders below its reference. Round-off limits the reachable drop to about 15 orders in double and 6
#     to 7 in single; a larger value runs to steady.max_iterations.
#
# steady.residual_ref_iterations = 5
#     ≥ 1. The reference is the largest residual over this many first iterations. During them the CFL stays at
#     steady.cfl0 (for grid sequencing see steady.sequencing_hold).
#
# steady.monitor_rel_tol = 1e-3
#     Finite, > 0. Relative tolerance of the monitors. The outer domain's value is also the joint run's tolerance on
#     the feedback's change over steady.monitor_window exchanges (nest.feedback other than none,
#     docs/boundary_conditions.rst, Two-way nests).
#
# steady.monitor_window = 50
#     ≥ 2. Monitor window (iterations; in a joint run, also the outer domain's window of exchanges for the feedback
#     test).
#
# steady.confidence = 0
#     0 (off) or finite, > 0 and ≤ 1: the run is also steady when this share of the cells meet the residual
#     criterion cell by cell and every monitor criterion is met (confidence stop, docs/solution_algorithm.rst).
#     SIMPLEC stage only.
#
# steady.confidence_height = 0
#     0 (anywhere) or finite, > 0 (m), only with steady.confidence > 0: every cell that does not meet the criterion
#     must also lie within this height above the ground.
#
# steady.cfl0 = 1
#     Finite, > 0. CFL number of the first iterations.
#
# steady.cfl_max = 8    # with lusgs, 10 with zjacobi
#     Finite, ≥ steady.cfl0. Largest CFL number. The default depends on steady.sweep (the sweep and CFL-cap study on
#     Askervein, docs/results.rst); a given value is used with either sweep. With the step floor off
#     (steady.dtau_floor = 0) a dense canopy needs a lower cap (docs/canopy.rst, steep terrain and the boundaries).
#
# steady.ser_exponent = 1
#     Finite, ≥ 0. Exponent p of the CFL ramp; 0 holds the CFL at cfl0.
#
# steady.ser_max_growth = 2
#     Finite, ≥ 1. Largest CFL growth factor per iteration.
#
# steady.dtau_floor = 0.1
#     Finite, ≥ 0. The local pseudo-time rate is kept at or above this fraction of the level's fastest convective
#     rate, U_max / min(Δ x, Δ y), so a cell at rest steps at most 1/dtau_floor times as the fastest cell does
#     (docs/solution_algorithm.rst, local time step). 0 is the plain local step, the form before the floor (a cell
#     at rest then steps cfl / 1e-12 s).
#
# steady.probes_file =    # —
#     A file of probe points, in the format of unsteady.probes_file (one x y h per line, m, h > 0 the height above
#     the ground; the same choice of cell and the same aborts). The values of u, v, w, θ, k before the first
#     iteration and after every iteration of level 0 go to <io.plot_file>_steady_probes.csv, whose first column is
#     the run's iteration count; a restart keeps its rows up to the checkpoint's iteration. The coarse levels of
#     grid sequencing write no rows. A deck with the blend (convection.hybrid_sigma_max) cannot restart, so it
#     cannot continue its file either. A row holds five numbers of 17 digits per probe (about 110 bytes), so 2500
#     probes over 1500 iterations make about 0.4 GB. Aborts with steady.stage = unsteady (unsteady.probes_file is
#     that stage's key) and without a stage. The name must not be empty.
#
# steady.switch_window = 20
#     ≥ 1. Iterations below switch_residual before a switch to the next stage; no other switch within this many
#     iterations of the last one (hysteresis), except the Newton stage's own hand-back.
#
# steady.switch_residual = 1e-4
#     > 0 and ≤ 1. Relative residual at which the Newton stage starts.
#
# steady.switch_back_growth = 10
#     Finite, > 1. Residual growth over a window that returns the run to the previous stage.
#
# steady.switch_monitor_tol = 1e-2
#     0 (off), or > 0 and < 1. The switch to Newton also needs every monitor to have changed by at most this
#     fraction of max(|value|, scale) over the window.
#
# steady.newton_fallback_failures = 2
#     Integer, ≥ 1. Consecutive failed Newton steps (every retry used) after which the run goes back to SIMPLEC.
#     After three such fallbacks the run stays in SIMPLEC.
#
# steady.newton_cfl_max = 128
#     Finite, ≥ steady.cfl_max (with simplec_newton). The Newton stage's CFL cap: from steady.cfl_max the CFL is
#     multiplied by steady.ser_max_growth per accepted step up to this cap, then (with steady.newton_dtau_inf_at_cap
#     = 1) Δ τ is infinite. The preconditioner of an infinite Δ τ uses this CFL.
#
# steady.sweep =    # lusgs (CPU build), zjacobi (GPU build)
#     zjacobi (z-line Jacobi) or lusgs (line LU-SGS). The default depends on the build (the sweep and CFL-cap study
#     on Askervein, docs/results.rst): a GPU build keeps zjacobi until the sweeps are measured on H100. zjacobi
#     reproduces the solver used before line LU-SGS became the CPU default. A restart takes the current default, not
#     the sweep of the run that wrote the checkpoint: give steady.sweep = zjacobi to continue a run that used the
#     old default. The steady.line_* keys need lusgs, so a deck that gives them should also give steady.sweep.
#
# steady.zline_sweeps = 2
#     Sweeps per iteration: 2 to 100 with zjacobi, 1 to 100 with lusgs. With zjacobi the stable CFL grows with the
#     sweeps: 0.9 with 2 (the default), 2.4 with 4, 3.7 with 8, 6.1 with 16 (a Fourier analysis, docs/results.rst).
#     The zjacobi default cap of 10 is above the 2-sweep value; see docs/results.rst for the runs that set it.
#
# steady.line_ghosts = lagged
#     lagged or zero; lusgs only. lagged: neighbours across a box face take the previous pass's values. zero: each
#     box sweeps on its own, without communication.
#
# steady.line_overlap = 0
#     Integer from 0 to 8, and at most the narrowest box width (on every hierarchy level with grid sequencing); > 0
#     only with line_ghosts = zero. Columns by which each box's swept region is grown.
#
# steady.line_order = sequential
#     sequential or diagonal; lusgs only. diagonal runs one column per GPU thread with the same result.
#
# steady.line_alternate = 0
#     0 or 1; lusgs only, with zline_sweeps ≥ 2. 1 reverses the y direction on every second sweep.
#
# steady.sequencing = 0
#     0 or 1. 1: grid sequencing over the mesh.hierarchy_levels levels (docs/solution_algorithm.rst). Needs
#     mesh.hierarchy_levels ≥ 2 and at least 2 cells in x and y on the coarsest level. init.* then acts on the
#     coarsest level only, and steady.max_iterations applies to each level. On a restart the coarse levels are
#     skipped and the steady.sequencing* keys have no effect (the log says so).
#
# steady.sequencing_drop_orders = 2
#     Finite, > 0 and ≤ steady.residual_drop_orders; with sequencing = 1 only. A coarse level stops once every
#     residual is this many orders below its reference, or below steady.residual_tol.
#
# steady.sequencing_monitor_tol = 0    # off
#     0, or finite, > 0 and < 1; with sequencing = 1 only. A coarse level also stops once every monitor changed by
#     at most this fraction over steady.monitor_window iterations.
#
# steady.sequencing_hold = 0
#     0 or 1; with sequencing = 1 only. 0: the seeded levels (all but the coarsest) skip the reference hold and ramp
#     the CFL from their first iteration. 1: every level holds the CFL at steady.cfl0 for its first
#     steady.residual_ref_iterations iterations. A restart keeps the setting of the checkpoint.
#
# steady.sequencing_cfl_start = cfl0
#     cfl0 or previous; with sequencing = 1 only. The CFL of a seeded level's first iteration: steady.cfl0, or the
#     CFL the previous level reached (at least steady.cfl0). previous needs steady.sequencing_hold = 0.
#
# steady.machine = local
#     local, kestrel-cpu or kestrel-gpu: allocation-unit rate (0, 10, 100 AU per node-hour).
#
# steady.nodes = 1
#     ≥ 1. Nodes of the run, for the allocation units.
#
# steady.newton_gmres_restart = 30
#     Integer from 5 to 200. GMRES restart length of the Newton step.
#
# steady.newton_fd_eps_scale =    # √(ε_mach)
#     ≥ ε_mach^(3/4) and ≤ 1e-2. Relative step of the Jacobian–vector product.
#
# steady.newton_krylov_rtol = 1e-2
#     > 0 and < 1. GMRES tolerance in each Newton step.
#
# steady.newton_mem_budget_gb = 70
#     > 0 and ≤ 80. Krylov memory per rank (GB); the run stops if the estimate exceeds it.
#
# steady.newton_gmres_max_iters = 2000
#     Integer, ≥ 1. GMRES iteration limit of one Newton step (all restarts). A solve that reaches it is unconverged;
#     its update goes through the usual usability rule.
#
# steady.newton_preconditioner = simplec
#     identity or simplec; any other value aborts and names the key. The preconditioner of each GMRES solve of the
#     Newton step (docs/solution_algorithm.rst). simplec: one SIMPLEC iteration with steady.sweep and
#     steady.zline_sweeps. identity: none.
#
# steady.newton_armijo_c = 1e-4
#     > 0 and < 0.5. Armijo constant c of the continuation's line search.
#
# steady.newton_backtrack = 0.5
#     > 0 and < 1. Backtracking factor β: λ = 1, β, β^2, …
#
# steady.newton_lambda_min = 1e-2
#     > 0 and < 1. The smallest λ tried; below it the attempt is rejected.
#
# steady.newton_cfl_cut = 0.25
#     > 0 and < 1. A rejected or skipped attempt multiplies the CFL by this factor (from infinite Δ τ:
#     steady.newton_cfl_max times it) and retries.
#
# steady.newton_max_retries = 4
#     Integer, ≥ 1. Retries of one continuation step; after the last the step returns failed.
#
# steady.newton_dtau_inf_at_cap = 1
#     0 or 1. 1: once the CFL reaches steady.newton_cfl_max, the next steps run without a pseudo-time term (D = 0,
#     plain Newton) until an attempt fails. 0: the CFL stays at the cap.
#
# steady.newton_ptc_growth = 1
#     Finite, ≥ 1. At a finite Δ τ, when no λ meets the Armijo condition, accept the full step if |R| grows by at
#     most this factor. 1: off. Not used at infinite Δ τ.

# ==================================================================================================================
# unsteady
# ==================================================================================================================
# See time-driver, docs/solution_algorithm.rst. Read with steady.stage = unsteady; without it every unsteady.* key
# aborts as a key with no effect. In an unsteady run the steady stop does not apply, so steady.max_iterations,
# steady.residual_drop_orders, steady.monitor_rel_tol, steady.monitor_window, steady.confidence,
# steady.confidence_height and io.iteration_log abort as keys with no effect; steady.residual_tol is the floor of
# the inner stop. steady.residual_ref_iterations sets how many inner iterations, counted over the run, hold the CFL
# at steady.cfl0; the other steady.* keys of the SIMPLEC stage act as in a steady run. steady.sequencing = 1,
# convection.hybrid_sigma_max > 0, turb.nut_relax_end > 0 and an immersed ground (terrain.representation =
# immersed_forcing or hybrid) are not supported yet and abort. A run may start from a steady checkpoint
# (io.restart): its physical time starts at 0 and the driver's history (CFL, residual reference, hold) continues
# from the checkpoint (time-driver, docs/solution_algorithm.rst). From a checkpoint of an unsteady run it continues
# that run: its time, step count and averages. The outputs (averages, probes, plotfiles and checkpoints during the
# run) and the restart are described in unsteady-outputs, docs/solution_algorithm.rst.
#
# unsteady.stop_time =    # —
#     Required; finite and > 0 (s). The physical time the run ends at; the last step is shortened to end there.
#
# unsteady.dt =    # —
#     Finite and > 0 with a finite 1/dt (s). The physical step. Required unless unsteady.cfl > 0; refused with it.
#     The last step takes the time left when that is within 0.1 % of dt.
#
# unsteady.cfl = 0
#     0 (use unsteady.dt) or finite and > 0. The target convective CFL: each step's Δ t is this times the inverse of
#     the largest convective rate over the cells. A field at rest has no such rate and stops the run at the first
#     step.
#
# unsteady.inner_drop_orders = 3
#     Finite, > 0 and ≤ 15. A step ends when every scaled residual is at or below 10^(-d) times its value at the
#     step's start, or below steady.residual_tol. 3 keeps the algebraic error below the time error when the inner
#     iteration converges slowly; 1 does not (time-driver, docs/solution_algorithm.rst).
#
# unsteady.max_inner = 50
#     ≥ 1. Inner iterations of a step at most; a step that reaches it is reported and the run goes on (it does not
#     fail the run).
#
# unsteady.average_start = 0
#     Finite, ≥ 0 and < unsteady.stop_time (s). The running mean and variance of u, v, w, θ, k (cell-centred) are
#     taken over the time after it, each step weighted by its part after this time. They are in every plotfile as
#     u_mean … tke_mean and u_var … tke_var (0 before any time is averaged). A restart must give the checkpoint's
#     value.
#
# unsteady.plot_interval = 0
#     ≥ 0. A plotfile after every so many physical steps, counted from the run's start (a restart counts on), and
#     the final one at the end. 0: the final one only. Needs io.write_plotfile = 1. The plotfiles are numbered by
#     the total of inner iterations, as the final one.
#
# unsteady.checkpoint_interval = 0
#     ≥ 0. A checkpoint after every so many physical steps, as unsteady.plot_interval, and the final one at the end.
#     Needs io.write_checkpoint = 1. A run that diverges writes no final checkpoint.
#
# unsteady.probes_file =    # —
#     A file of probe points, one x y h per line (m; # starts a comment), h > 0 the height above the ground. Each
#     probe takes the cell of its column whose centre is nearest h (the lower one on a tie); a point outside the
#     domain or above the column's top aborts. The values of u, v, w, θ, k at the start and after each step go to
#     <io.plot_file>_probes.csv; a restart keeps its rows up to the checkpoint's time.

# ==================================================================================================================
# simplec
# ==================================================================================================================
# See docs/solution_algorithm.rst. Read with steady.stage = simplec or simplec_newton.
#
# simplec.pressure_reltol = 1e-3
#     ≥ 10 machine epsilon and < 1: relative tolerance of the pressure-correction solve. Looser values can be
#     unstable in stratified flow.
#
# simplec.alpha_p = 1
#     > 0 and ≤ 1: pressure under-relaxation.
#
# simplec.rotation_relax = 0.3
#     > 0 and ≤ 1: step of the point-implicit rotation, in inertial times. 1 often converges faster (the hill cases
#     use it).
#
# simplec.w_vnn_cap = 0    # off
#     0, or finite and ≥ 16: the cap V on the vertical VNN number of the w rows. Changes the path, not the answer.
#     May change across a restart.
#
# simplec.w_vnn_cap_slope_margin = 4
#     0 (off), or finite and ≥ 1; refused unless simplec.w_vnn_cap > 0. The safety factor s that lowers the cap on
#     sloping ground so the pressure operator stays definite (docs/solution_algorithm.rst). 0 is the cap of #32,
#     which can stall where thin cells meet steep slopes; the run then warns over terrain when the mesh aspect ratio
#     is above the tested 50.78. Changes the path, not the answer. May change across a restart.
#
# simplec.theta = solve
#     solve or frozen. frozen: θ is the inflow profile's θ by height above the ground on every sequenced level (the
#     steady column's θ with init.first_guess = column and a non-neutral init.column_stability) and is not solved
#     (in a canopy with canopy.heat_frozen = blend, blended towards the leaves' θ, docs/canopy.rst); the momentum
#     equations carry no buoyancy force, the closure keeps N^2 (docs/solution_algorithm.rst, prescribed potential
#     temperature). Needs grid sequencing (steady.sequencing = 1, mesh.hierarchy_levels > 1) or init.first_guess =
#     nest. A patch (init.first_guess = nest) holds the θ of its parent run (bc.nest_parent), interpolated, whether
#     the parent solved θ or held it; a nest of nest.names holds the θ it starts from (the outer domain's,
#     interpolated). Refused with steady.stage = simplec_newton, with io.restart, and in a patch with steady.stage =
#     unsteady. With frozen, theta in bc.rayleigh_fields and bc.zhi_theta_grad have no effect, and in a patch with
#     nest faces on its four sides bc.theta_profile is not used.

# ==================================================================================================================
# solver
# ==================================================================================================================
# See docs/solution_algorithm.rst. Read when init.first_guess is not none or with the SIMPLEC stage; refused
# otherwise.
#
# solver.poisson_backend = gmres_mlmg
#     gmres_mlmg (GMRES with multigrid), mlmg (multigrid alone) or gmres_fft (ERF's operator with an FFT
#     preconditioner).
#
# solver.poisson_reltol = 1e-10    # 1e-5 single
#     ≥ 10 machine epsilon and < 1. Converged when the residual is below this fraction of the initial one. In single
#     precision the rounding floor of the residual is about ε N_z^2/2 (ε the machine epsilon, N_z the vertical
#     cells; 2e-4 on 64 layers), so the default 1e-5 lies below it once N_z > 13; use about 4ε N_z^2 there.
#
# solver.poisson_abstol = 0
#     Finite, ≥ 0. Converged when the residual is below this value.
#
# solver.poisson_max_iter = 200
#     ≥ 1. GMRES iterations, or multigrid cycles with mlmg; the run stops when it is reached.
#
# solver.poisson_restart = 50
#     ≥ 1. GMRES restart length; not with mlmg.
#
# solver.poisson_precond = fft
#     fft or none; only with gmres_fft.
#
# solver.poisson_verbose = 0
#     ≥ 0. 1 prints each solve; 2 also prints the residual at each GMRES restart.

# ==================================================================================================================
# io
# ==================================================================================================================
#
# io.plot_file = plt
#     Plotfile prefix; not empty.
#
# io.chk_file = chk
#     Checkpoint prefix; not empty.
#
# io.write_plotfile = 1
#     0 or 1: write the plotfile at the end of the run.
#
# io.write_checkpoint = 1
#     0 or 1: write the checkpoint at the end of the run (and, in an unsteady run, every
#     unsteady.checkpoint_interval steps).
#
# io.turb_plot_file =    # none
#     Prefix of the turbulence plotfile with ERF's variable names (docs/output.rst). Needs the SIMPLEC stage.
#
# io.iteration_log = table
#     table or full: the per-iteration log (docs/output.rst). table: aligned columns (iteration, CFL, line solver,
#     the u, v, w, tke, theta and p residuals, r). full: one gust: it line per row with every diagnostic (the log
#     before this input).
#
# io.column_guess_file = column_guess.dat
#     Not empty. The file the converged column's table (z u v theta k, full precision) is written to, on the I/O
#     rank; it reads back as a bc.inflow_file. A table that cannot be written gives a warning, not a stop. Refused
#     without init.first_guess = column (no effect).
#
# io.restart =    # none
#     Checkpoint directory to restart from (docs/running.rst). A run that would write a checkpoint into this
#     directory (io.chk_file and the step give the same directory, however the paths are spelled) stops.

# ==================================================================================================================
# nest
# ==================================================================================================================
# Nests: finer meshes inside the domain, run in the same process after the outer domain
# (docs/initial_conditions.rst). A nest has no deck of its own: it takes every other key from the outer deck. Its
# derived settings are refinement 2 2 1, the outer z-levels and mesh.max_grid_size, one grid level, the four lateral
# faces nest with the outer run's final checkpoint as bc.nest_parent (periodic across a periodic outer direction the
# nest spans whole), init.first_guess = nest (of the other init.* keys only init.projection, init.alpha_h and
# init.alpha_v apply), no grid sequencing, no sponge, the outer Rayleigh layer without u, v and k, no
# steady.probes_file, and io.plot_file, io.chk_file and io.turb_plot_file with _<name> appended. An Agnesi hill
# stays at the outer domain's centre, and the forcing is the outer run's final forcing.
#
# nest.names =    # none
#     Names of the nests, each once: a letter, then letters, digits or _; not names, feedback, feedback_factor,
#     feedback_flux or damping. With nests the outer deck needs steady.stage = simplec or simplec_newton and
#     io.write_checkpoint = 1; buildings are refused, and so is terrain.smoothing = 1 over terrain other than flat.
#     The nests run only if the outer domain reaches steady; GUST stops with an error after the nests if one did not
#     (with nest.feedback other than none, after the joint run).
#
# nest.<name>.lo =    # required
#     Two finite values x y (m): the nest's low corner, on the outer cell faces, at least 2 outer cells inside each
#     non-periodic outer face (within 1e-4 cells; moved onto the face). Nests may touch, not overlap; a nest may not
#     cover the whole outer domain in x and y.
#
# nest.<name>.hi =    # required
#     Two finite values x y (m): the high corner, above nest.<name>.lo, on the outer cell faces, at least 2 outer
#     cells inside each non-periodic outer face.
#
# nest.feedback = none
#     none, defect, relax, relax_consistent or inject. none: one way, the nests after the outer domain. defect:
#     after the one-way runs, the outer domain and every nest iterate together in memory, the nests' faces taking
#     the outer field and the outer domain taking the nests' solution over their footprints through a defect source
#     (two-way-nests, docs/boundary_conditions.rst). relax: the same joint run, with a relaxation of the outer
#     domain towards the nests' solution over their footprints in place of the defect source (two-way-relax,
#     docs/boundary_conditions.rst). relax_consistent: relax with w R_c(q^*) subtracted, the outer residual of the
#     restricted nests weighted by the relaxation's weight, so that the restricted nests' state satisfies the outer
#     rows pointwise where the weight is 1 (two-way-relax-consistent, docs/boundary_conditions.rst). inject: the
#     same joint run, with the outer state moved towards the restricted nests over their footprints at each exchange
#     and held there as data through the outer iteration (two-way-inject, docs/boundary_conditions.rst). Given only
#     with nest.names (any value). defect, relax, relax_consistent and inject are refused with steady.stage =
#     simplec_newton, with u, v or tke in bc.rayleigh_fields (unless nest.damping = outer), and when an odd
#     mesh.max_grid_size splits a nest into boxes with an odd number of cells in x or y, or when a nest spans fewer
#     than 5 outer cells in a non-periodic x or y (the source keeps 2 cells from each face). inject is also refused
#     with solver.poisson_backend = mlmg (its operator has no held cells) and with a nest across a periodic x or y
#     (the held region would cut the outer fluid in two). With bc.sponge_width > 0 the run prints a note: the nests
#     have no side sponge. With defect the one-way nest runs already use the joint run's coordinate surfaces, so
#     they differ from a none run's (the same holds for relax, relax_consistent and inject). steady.max_iterations
#     also caps the joint exchanges, counted over the run; io.restart with a joint run's checkpoint continues the
#     joint run (two-way-nests, docs/boundary_conditions.rst, Restart). The joint run is steady when every domain is
#     steady and the feedback has settled over the outer domain's steady.monitor_window exchanges to its
#     steady.monitor_rel_tol; otherwise it stops with an error.
#
# nest.feedback_factor = 0.5    # 1 with relax_consistent
#     Dimensionless; given only with nest.feedback = relax, relax_consistent or inject, once. With relax and
#     relax_consistent: finite, > 0, the relaxation's rate over the advection rate, f in c = w(s) f U / Δ x, U the
#     nest's mean horizontal speed and Δ x the smaller of the outer Δ x, Δ y (two-way-relax,
#     docs/boundary_conditions.rst). With relax a larger factor holds the outer domain closer to the nest under it,
#     but does not by itself bring either domain closer to a fine run (two-way-relax, docs/boundary_conditions.rst,
#     Results); its default was 1 in earlier versions, and nest.feedback_factor = 1 keeps that answer. With
#     relax_consistent the restricted nests satisfy the outer rows where the weight is 1 at any factor; the factor
#     sets the rate on the margin and the iteration (two-way-relax-consistent, docs/boundary_conditions.rst). With
#     inject: finite, > 0 and <= 1, the fraction ω of the way the outer state moves towards the restricted nests at
#     each exchange (two-way-inject, docs/boundary_conditions.rst); 1 replaces it fully. A smaller factor takes more
#     exchanges to the same state; 0.75 and 1 did not reach steady on the canonical hill (two-way-inject,
#     docs/boundary_conditions.rst, Results). For all three, the joint record holds the value. A restart uses the
#     deck's value or the default; where that differs from the record's, the joint stop test's window fills again
#     and the log gives both values (two-way-nests, docs/boundary_conditions.rst, Restart).
#
# nest.feedback_flux = outer
#     outer or nest. outer: the outer row just outside each nest's source region keeps the outer scheme's flux of
#     the restricted nest state through the region's lateral faces. nest: that row takes the nests' own fluxes
#     through those faces, summed over the nest faces (the conservative variant, Conservative faces,
#     docs/boundary_conditions.rst); it costs one more nest residual per exchange. Given only with nest.feedback =
#     defect, once.
#
# nest.damping = w_theta
#     w_theta or outer. w_theta: the nests' Rayleigh layer damps w and θ only, whatever bc.rayleigh_fields names.
#     outer: the nests keep the outer deck's bc.rayleigh_fields, so the layer damps u, v and k towards the
#     bc.inflow_* profile in the nests as in the outer domain over their footprints (a flat, horizontally uniform
#     ABL with a column table, Tests/Canonical_RANS/Nests_Flat_ABL). Given only with nest.names, once, with one
#     value; outer is refused without a layer on u, v or tke (bc.rayleigh_zdamp > 0, bc.rayleigh_dampcoef > 0 and u,
#     v or tke in bc.rayleigh_fields). Tested on flat ground only.

