# Bolund, wind from 270 degrees, with the terrain and the roughness map both read from files named here:
# terrain.file = bolund.xyz ("x y z" points) and bc.surface_z0_file = bolund_z0.xyz ("x y z0" points), made by
# to_gust_xyz.py in this folder from the Bolund GeoTIFF (README.md). Run from the folder that holds the two files.
# Roughness: 0.0003 m over water and 0.015 m over land (the Bolund blind comparison's values, Bechmann et al.
# 2011). Inflow: the log law over water, z0 = 0.0003 m, with u* giving 10.9 m/s at 5 m (kappa = 0.41), towards
# 0 degrees counter-clockwise from x. 256 x 128 x 48 cells over 800 m x 420 m (3.1 m x 3.3 m), a 0.5 m first
# layer stretched by 1.0579 to 120 m; truly neutral; damping of w from 80 m. Mesh, solver and lee settings are
# those of ../WindNinja2019/inputs_bolund_270, which uses one roughness (0.01 m) and takes terrain.file on the
# command line.
mesh.n_cell           = 256 128 48
mesh.prob_lo          = -400. -210. 0.
mesh.prob_hi          =  400.  210. 120.
mesh.max_grid_size    = 32
mesh.dz0              = 0.5
mesh.stretch_ratio    = 1.0579
mesh.hierarchy_levels = 3

terrain.type      = xyz
terrain.file      = bolund.xyz
terrain.smoothing = 0

bc.xlo = inflow
bc.xhi = outflow
bc.ylo = slip_wall
bc.yhi = slip_wall
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0_file  = bolund_z0.xyz
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.4597
bc.inflow_z0        = 0.0003
bc.inflow_direction = 0.
bc.theta_profile_z  = 0.
bc.theta_profile    = 300.
bc.rayleigh_zdamp    = 80.
bc.rayleigh_dampcoef = 0.2
bc.rayleigh_fields   = w

init.first_guess = profile
init.alpha_h     = 1.0
init.alpha_v     = 0.5

solver.poisson_reltol   = 1.e-10
solver.poisson_max_iter = 200

forcing.gravity  = 0.
turb.tke_floor   = 1.e-6
simplec.w_vnn_cap = 16

# The recommended GUST - CFD setting (lee wake): the nu_t cap C_r k/S with C_r = Cmu0^2, nu_t under-
# relaxation, a 10 % blend towards upwind where the cap holds nu_t below 2.5 terrain heights, and (except where
# the deck sets its own) a 100 m Blackadar length.
turb.realizability = 0.309
turb.nut_relax     = 0.5
turb.max_geom_lscale = 100.
convection.hybrid_sigma_max = 0.1
convection.hybrid_height    = 30.

steady.stage          = simplec
steady.sweep          = lusgs
steady.zline_sweeps   = 2
steady.cfl_max        = 16
steady.sequencing     = 1
steady.max_iterations = 20000

io.plot_file        = plt
io.turb_plot_file   = turb
io.chk_file         = chk
io.write_checkpoint = 0
