# Big Southern Butte (Idaho) at 128 m cells: 80 x 80 cells (10.24 km a side) centred on the butte, 56 layers (10 of
# 2 m, then 1.15 until 128 m, then 128 m to 3063 m) on the hybrid mesh: the mesh follows the terrain's
# lower envelope (terrain.hybrid_half_width = 256 m) and the ground is immersed in it, one level, LU-SGS. The log
# law, 8 m/s at 10 m over z0 = 0.0301 m (the geometric mean of the roughness map along the xlo face), blows along x
# through xlo; outflow at xhi, slip sides, a slip top with damping of w from 2400 m; truly neutral (300 K, no
# buoyancy, no Coriolis). The terrain (terrain.xyz), the roughness map (roughness.xyz) and the levels
# (../zlevels_128m.txt) are given on the command line (README.md):
#   terrain.file=terrain.xyz bc.surface_z0_file=roughness.xyz mesh.zlevels_file=../zlevels_128m.txt
# The terrain-following decks' levels: on the 4 m levels of ../zlevels_128m_hybrid.txt r was still 2.4e-4 after 1850
# iterations, against the steady verdict after 327 on these levels (README.md).
mesh.n_cell        = 80 80 56
mesh.prob_lo       = -5120. -5120. 0.
mesh.prob_hi       =  5120.  5120. 3063.490293
mesh.max_grid_size = 32

terrain.type      = xyz
terrain.smoothing = 1   # STF: the levels above the hybrid mesh's lower face are smoothed as on the body-fitted mesh
terrain.representation   = hybrid
terrain.flat_height      = 2.     # the first layer of zlevels_128m.txt (the default, given here)
terrain.hybrid_half_width = 256.  # 2 cells (the default, given here): the narrowest width that converged in the
                                  # calibration of docs/immersed_terrain.rst; tools/hybrid_width.py finds no width
                                  # that also keeps the gap below 0.2 of the relief on this mesh
terrain.small_volfrac    = 0.1    # as Immersed_Terrain_Cases: merges thin cut cells into the ground

bc.xlo = inflow
bc.xhi = outflow
bc.ylo = slip_wall
bc.yhi = slip_wall
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.5650   # 0.41 x 8 / ln(10 / 0.0301); 8.005 m/s at 10 m with ln((z + z0) / z0)
bc.inflow_z0        = 0.0301
bc.inflow_direction = 0.
bc.theta_profile_z  = 0.
bc.theta_profile    = 300.
bc.rayleigh_zdamp    = 2400.
bc.rayleigh_dampcoef = 0.2
bc.rayleigh_fields   = w

abl.drive = inflow_only

init.first_guess = profile
init.alpha_h     = 1.0
init.alpha_v     = 0.5

solver.poisson_reltol   = 1.e-10
solver.poisson_max_iter = 200

forcing.gravity = 0.
turb.tke_floor  = 1.e-6
simplec.w_vnn_cap = 16   # thin first cells (aspect ratio 64)

# The recommended setting (docs/turbulence_model.rst): realizability cap, relaxation of nu_t, and the blend
# towards first-order upwind below 2.5 terrain heights.
turb.realizability          = 0.309
turb.nut_relax              = 0.5
turb.max_geom_lscale        = 100.
# The cut cells take the shear from the log law (as the immersed cases do).
turb.shear_stencil          = log_law
convection.hybrid_sigma_max = 0.1
convection.hybrid_height    = 1950.   # 2.5 x 779 m

steady.stage          = simplec
steady.sweep          = lusgs
steady.zline_sweeps   = 2
steady.cfl_max        = 16
steady.max_iterations = 20000

io.plot_file        = plt
io.turb_plot_file   = turb
io.chk_file         = chk
io.write_checkpoint = 0
