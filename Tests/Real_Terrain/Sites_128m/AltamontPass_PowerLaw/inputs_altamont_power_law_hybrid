# Altamont Pass (California) at 128 m cells: 64 x 64 cells (8.19 km a side), 127 layers (88 of 4 m to 352 m, then 1.15
# until 128 m, then 128 m layers, the top one 72 m, to 3063 m) on the hybrid mesh: the mesh follows the terrain's
# lower envelope (terrain.hybrid_half_width = 256 m) and the ground is immersed in it, one level, LU-SGS. The power
# law, 8 m/s at 10 m with the exponent 0.143, blows along x through xlo; its k takes z0 = 0.0591 m (the geometric mean
# of the roughness map along the xlo face). Outflow at xhi, slip sides, a slip top with damping of w from 2400 m;
# truly neutral (300 K, no buoyancy, no Coriolis). The terrain (terrain.xyz), the roughness map (roughness.xyz) and
# the levels (../zlevels_128m_hybrid.txt) are given on the command line (README.md):
#   terrain.file=terrain.xyz bc.surface_z0_file=roughness.xyz mesh.zlevels_file=../zlevels_128m_hybrid.txt
mesh.n_cell        = 64 64 127
mesh.prob_lo       = -4096. -4096. 0.
mesh.prob_hi       =  4096.  4096. 3063.490293
mesh.max_grid_size = 32

terrain.type      = xyz
terrain.smoothing = 1   # STF: the levels above the hybrid mesh's lower face are smoothed as on the body-fitted mesh
terrain.representation   = hybrid
terrain.flat_height      = 4.     # the first layer of zlevels_128m_hybrid.txt (the default, given here)
terrain.hybrid_half_width = 256.  # 2 cells (the default, given here): the narrowest width that converged in the
                                  # calibration of docs/immersed_terrain.rst; tools/hybrid_width.py finds no width
                                  # that also keeps the gap below 0.2 of the relief on this mesh
terrain.small_volfrac    = 0.1    # as Immersed_Terrain_Cases: merges thin cut cells into the ground

bc.xlo = inflow
bc.xhi = outflow
bc.ylo = slip_wall
bc.yhi = slip_wall
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.inflow_profile   = power_law
bc.inflow_speed     = 8.
bc.inflow_zref      = 10.
bc.inflow_alpha     = 0.143
bc.inflow_z0        = 0.0591
bc.inflow_direction = 0.
bc.theta_profile_z  = 0.
bc.theta_profile    = 300.
bc.rayleigh_zdamp    = 2400.
bc.rayleigh_dampcoef = 0.2
bc.rayleigh_fields   = w

abl.drive = inflow_only

init.first_guess = profile
init.alpha_h     = 1.0
init.alpha_v     = 0.5

solver.poisson_reltol   = 1.e-10
solver.poisson_max_iter = 200

forcing.gravity = 0.
turb.tke_floor  = 1.e-6
simplec.w_vnn_cap = 16   # thin first cells (aspect ratio 32)

# The recommended setting (docs/turbulence_model.rst): realizability cap, relaxation of nu_t, and the blend
# towards first-order upwind below 2.5 terrain heights.
turb.realizability          = 0.309
turb.nut_relax              = 0.5
turb.max_geom_lscale        = 100.
# The cut cells take the shear from the log law (as the immersed cases do).
turb.shear_stencil          = log_law
convection.hybrid_sigma_max = 0.1
convection.hybrid_height    = 1130.   # 2.5 x 452 m

steady.stage          = simplec
steady.sweep          = lusgs
steady.zline_sweeps   = 2
steady.cfl_max        = 16
steady.max_iterations = 20000

io.plot_file        = plt
io.turb_plot_file   = turb
io.chk_file         = chk
io.write_checkpoint = 0
