# bolund_270 on a flat mesh with the ground immersed in it (terrain.representation = immersed_forcing): the case of
# ../WindNinja2019/inputs_bolund_270 in the settings of inputs_bolund_270_body_fitted, its partner. On the command line:
# terrain.file=bolund.xyz mesh.zlevels_file=zlevels_bolund.txt (README.md). The keys that differ from the
# parent deck are at the end; the parent's text follows.
# This deck has 256 x 128 x 74 cells on the layers of mesh.zlevels_file; the cell counts, layers, iteration counts and times in the parent's text
# are the parent's.
#
# Wagenbrenner et al. (2019) comparison, Bolund case 1: wind 10.9 m/s from 270 degrees at
# 5 m (towards 0 degrees counter-clockwise from x). Terrain: windninja-tools'
# bolund_hill_extended.tif (0.25 m) as xyz every 1 m (windninja2019.py prepare;
# terrain.file on the command line), Bolund's own frame (origin near the hilltop).
# 256 x 128 x 48 cells over 800 m x 420 m (3.1 m x 3.3 m; the paper's CFD had 3.8 m), a
# 0.5 m first layer stretched by 1.0579 to 120 m; the log law with z0 = 0.01 m ("grass",
# as the paper) and u* giving 10.9 m/s at 5 m; truly neutral; damping of w from 80 m.
mesh.prob_lo          = -400. -210. 0.
mesh.max_grid_size    = 32

terrain.type      = xyz

bc.xlo = inflow
bc.xhi = outflow
bc.ylo = slip_wall
bc.yhi = slip_wall
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0       = 0.01
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.7189
bc.inflow_z0        = 0.01
bc.inflow_direction = 0.
bc.theta_profile_z  = 0.
bc.theta_profile    = 300.
bc.rayleigh_zdamp    = 80.
bc.rayleigh_dampcoef = 0.2
bc.rayleigh_fields   = w

init.first_guess = profile
init.alpha_h     = 1.0
init.alpha_v     = 0.5

solver.poisson_reltol   = 1.e-10
solver.poisson_max_iter = 200

forcing.gravity  = 0.
turb.tke_floor   = 1.e-6
simplec.w_vnn_cap = 16

# The recommended GUST - CFD setting (lee wake): the nu_t cap C_r k/S with C_r = Cmu0^2, nu_t under-
# relaxation, a 10 % blend towards upwind where the cap holds nu_t below 2.5 terrain heights, and (except where
# the deck sets its own) a 100 m Blackadar length.
turb.realizability = 0.309
turb.nut_relax     = 0.5
convection.hybrid_sigma_max = 0.1
convection.hybrid_height    = 30.

steady.stage          = simplec
steady.max_iterations = 20000

io.plot_file        = plt
io.turb_plot_file   = turb
io.chk_file         = chk
io.write_checkpoint = 0
turb.max_geom_lscale = 100
steady.sweep = zjacobi
steady.zline_sweeps = 16
steady.cfl_max = 4
turb.shear_stencil = log_law
turb.wall_distance = terrain_height
solver.poisson_backend = gmres_fft
terrain.representation = immersed_forcing
terrain.flat_height = 0.75
terrain.small_volfrac = 0.1
mesh.n_cell = 256 128 74
mesh.prob_hi = 400. 210. 126.5358048
