# Variant of inputs_winsent with the ground roughness map of the kynema-sgf WINSENT runs (roughness.xyz from
# prepare_gust.py --roughness) in place of the uniform z0 = 0.1 m; bc.inflow_z0 stays 0.1. Everything else as below.
# WINSENT Phase I, the six steady cases on ERF's blended domain (the tables from prepare_gust.py, run from the
# run folder).
# Flow from the valley lidar L140 up the forested Albtrauf to the plateau mast MMNW, on a mesh rotated so +x
# points downwind (wind from 293 deg), origin at MMNW, heights in metres above 350 m NHN. The set-up mirrors the
# ERF deck of the same case: 416 x 320 x 32 cells (dx = 32 m), periodic in y, ERF's 32 stretched levels to
# 2400 m, the lidar inflow on xlo (k = 0.2 as ERF's xlo.KE), outflow on xhi, z0 = 0.1 m, slip top, a Rayleigh
# layer on w over ERF's top 500 m (ERF's rayleigh_zdamp is a depth from the top; GUST's is the start height),
# realizability 0.309, uniform canopy with Cd 0.15 and the k terms.
# Given on the command line: steady.cfl_max (2 for both LAIs in the runs of README.md: the dense canopy on the steep
# slope, docs/canopy.rst), steady.max_iterations, and simplec.theta = frozen for the stable and unstable cases (theta
# prescribed from the inflow column, README.md). The stratified cases use this same deck with their own inflow.txt.
mesh.n_cell           = 416 320 32
mesh.prob_lo          = -7168. -5120. 0.
mesh.prob_hi          =  6144.  5120. 2400.
mesh.is_periodic      = 0 1 0
mesh.max_grid_size    = 64
mesh.zlevels_file     = zlevels.txt
mesh.hierarchy_levels = 3

terrain.type      = erf_grid
terrain.file      = terrain.txt
terrain.smoothing = 0

init.first_guess = profile

bc.xlo = inflow
bc.xhi = outflow
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0_file = roughness.xyz
bc.inflow_profile = file
bc.inflow_file    = inflow.txt
bc.inflow_z0      = 0.1
bc.rayleigh_zdamp    = 1900.
bc.rayleigh_dampcoef = 0.2
bc.rayleigh_fields   = w

canopy.type        = map
canopy.height_file = canopy_height.xyz
canopy.lai_file    = canopy_lai.xyz
canopy.cd          = 0.15

turb.tke_floor     = 1.e-6
turb.realizability = 0.309

steady.stage      = simplec
steady.sequencing = 1

io.plot_file      = winsent_plt
io.turb_plot_file = winsent_turb
io.chk_file       = winsent_chk
