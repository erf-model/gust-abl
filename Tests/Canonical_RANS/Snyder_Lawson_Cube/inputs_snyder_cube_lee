# inputs_snyder_cube with the closure's lee options of the WindNinja terrain decks: the eddy-viscosity cap
# (turb.realizability) and the upwind blend. buildings.limiter_zone (default 3 building heights) fades both out
# around the cube, whose edges fix its separation; buildings.limiter_zone=0 on the command line keeps them there.
# On the command line: buildings.file=cube_snyder.txt mesh.zlevels_file=zlevels_5mm.txt. README.md has the case.
mesh.n_cell        = 160 60 90
mesh.prob_lo       = 0. 0. 0.
mesh.prob_hi       = 3.2 1.2 1.2
mesh.is_periodic   = 0 0 0
mesh.max_grid_size = 40 30

terrain.type = flat

bc.xlo = inflow
bc.xhi = outflow
bc.ylo = slip_wall
bc.yhi = slip_wall
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0       = 0.001
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.2374
bc.inflow_z0        = 0.001
bc.inflow_direction = 0.
bc.theta_profile_z  = 0.
bc.theta_profile    = 300.

forcing.gravity = 0.
turb.tke_floor  = 1.e-8

# A smooth cube: the wall law with the roughness Wise et al. found best at 5 mm cells.
buildings.type = immersed_forcing
buildings.z0   = 0.0001

init.first_guess = profile

steady.stage          = simplec
steady.sweep          = zjacobi
steady.zline_sweeps   = 3
steady.cfl_max        = 8
steady.max_iterations = 3000

# The lee options of the WindNinja terrain decks; the blend's height is 2.5 cube heights, as 2.5 terrain heights there.
turb.realizability          = 0.309
turb.nut_relax              = 0.5
convection.hybrid_sigma_max = 0.1
convection.hybrid_height    = 0.5

io.plot_file = snyder_plt
io.write_checkpoint = 0
