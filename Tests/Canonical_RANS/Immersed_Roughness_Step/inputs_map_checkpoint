# Two iterations over the roughness step, so that the run writes a checkpoint whose record of the ground holds
# the roughness map (ImmersedTerrain: the file's SHA-256 and the interpolation's settings). The mesh of
# inputs_immersed_step; terrain.representation, terrain.flat_height, bc.surface_z0_file and
# terrain.idw_neighbors are given on the command line (README.md).
mesh.n_cell        = 64 4 67
mesh.prob_lo       = 0. 0. 0.
mesh.prob_hi       = 2560. 160. 1046.875
mesh.is_periodic   = 0 1 0
mesh.max_grid_size = 32 4

terrain.type = flat

bc.xlo = inflow
bc.xhi = outflow
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.theta_profile_z = 0.
bc.theta_profile   = 300.
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.35
bc.inflow_z0        = 0.03
bc.inflow_direction = 0.

init.first_guess = profile

forcing.gravity = 0.

turb.tke_floor       = 1.e-6
turb.realizability   = 0.309
turb.nut_relax       = 0.5
turb.max_geom_lscale = 100.

steady.stage                   = simplec
steady.sweep                   = zjacobi
steady.cfl0                    = 1.
steady.cfl_max                 = 4.
steady.zline_sweeps            = 16
steady.residual_ref_iterations = 100
steady.residual_drop_orders    = 4
steady.max_iterations          = 2

solver.poisson_backend = gmres_fft

io.plot_file = step_map_plt
io.chk_file  = step_map_chk
