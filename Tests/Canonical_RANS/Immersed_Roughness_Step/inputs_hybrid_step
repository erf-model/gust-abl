# The ground of inputs_body_fitted_step on a hybrid mesh (the terrain is flat, so the mesh is the body-fitted
# one); terrain.flat_height, the ground's height above the lower face (0: the lower face is the ground and the
# surface layer acts on it; more: the ground cuts the first layer), and bc.surface_z0_file are given on the
# command line (README.md).
mesh.n_cell        = 64 4 64
mesh.prob_lo       = 0. 0. 0.
mesh.prob_hi       = 2560. 160. 1000.
mesh.is_periodic   = 0 1 0
mesh.max_grid_size = 16 2

terrain.type = flat
terrain.representation = hybrid
terrain.idw_neighbors = 1   # z0_step.xyz: each column takes its nearest point's value

bc.xlo = inflow
bc.xhi = outflow
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.theta_profile_z = 0.
bc.theta_profile   = 300.
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.35
bc.inflow_z0        = 0.03
bc.inflow_direction = 0.

init.first_guess = profile

forcing.gravity = 0.

turb.tke_floor       = 1.e-6
turb.realizability   = 0.309
turb.nut_relax       = 0.5
turb.max_geom_lscale = 100.
convection.hybrid_sigma_max = 0.1
convection.hybrid_height    = 250.

steady.stage                   = simplec
steady.sweep                   = zjacobi
steady.cfl0                    = 1.
steady.cfl_max                 = 4.
steady.zline_sweeps            = 16
steady.residual_ref_iterations = 100
steady.residual_drop_orders    = 4
steady.max_iterations          = 20000

solver.poisson_backend = gmres_fft

io.plot_file      = hybrid_step_plt
io.turb_plot_file = hybrid_step_turb
io.write_checkpoint = 0
