# A horizontally uniform dense canopy in a neutral flow driven by a constant pressure
# gradient over flat ground (Canonical_RANS/Homogeneous_Canopy). 8 x 8 x 143 cells on 800 m x 800 m x
# 199.7 m, periodic sides, four boxes, a 0.25 m first layer stretched by 1.02 (about 48 layers in
# the canopy, 0.65 m at its top), the surface layer on the ground (z0 = 0.01 m), a slip lid: u*^2 = F H,
# with F = 1.25e-3 m/s^2. No buoyancy. The check gives the canopy tables and the LAI.
mesh.n_cell        = 8 8 143
mesh.prob_lo       = 0. 0. 0.
mesh.prob_hi       = 800. 800. 199.7
mesh.is_periodic   = 1 1 0
mesh.max_grid_size = 4 4
mesh.dz0           = 0.25
mesh.stretch_ratio = 1.02

terrain.type = flat

abl.drive = pressure_driven
abl.theta = neutral

init.first_guess = column

bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0 = 0.01
bc.theta_profile_z = 0.
bc.theta_profile   = 300.
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.5
bc.inflow_z0        = 0.01
bc.inflow_direction = 0.

forcing.gravity           = 0.
forcing.pressure_gradient = 1.25e-3 0. 0.

canopy.type        = map
canopy.height_file = h.xyz
canopy.lai_file    = lai.xyz
canopy.cd          = 0.2

turb.tke_floor = 1.e-6

steady.stage      = simplec
steady.dtau_floor = 1

io.plot_file = homogeneous_plt
io.chk_file  = homogeneous_chk
