# The whole domain of the one-way patches around a cube and a raised plate
# (tracker row PR-76, beyond plan rev. 6): flat ground, a log-law inflow along x
# at xlo (u* = 0.4 m/s), outflow at xhi, periodic in y, the surface layer below
# and a slip top; the building from buildings.file with the form 7 wall law
# (Tests/Canonical_RANS/Building_Cube); SIMPLEC with z-line sweeps (buildings
# need them) to the steady verdict, with the recommended closure setting of
# docs/turbulence_model.rst. nest_shapes.py gives the domain (mesh.prob_hi,
# mesh.n_cell and the layers), the roughness, the building file,
# turb.max_geom_lscale, convection.hybrid_height (2.5 building heights) and the
# output names on the command line.
mesh.prob_lo       = 0. 0. 0.
mesh.is_periodic   = 0 1 0

terrain.type = flat

bc.xlo = inflow
bc.xhi = outflow
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.4
bc.inflow_direction = 0.
bc.theta_profile_z  = 0.
bc.theta_profile    = 300.
forcing.gravity = 0.

turb.tke_floor       = 1.e-6
turb.realizability   = 0.309
turb.nut_relax       = 0.5
convection.hybrid_sigma_max = 0.1

buildings.type   = immersed_forcing

init.first_guess = profile

steady.stage          = simplec
steady.sweep          = zjacobi
steady.zline_sweeps   = 3
steady.cfl_max        = 8
steady.max_iterations = 4000
