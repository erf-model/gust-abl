# A patch around the building of inputs_building_domain (tracker row PR-76,
# beyond plan rev. 6): nest faces at xlo and xhi, the parent's field as the
# first guess, the same layers, building file and settings. nest_shapes.py
# gives the place and cells, the y faces (nest, or periodic where the patch
# spans the parent's width), the parent (bc.nest_parent), the boxes and the
# output names on the command line.
terrain.type = flat

bc.xlo = nest
bc.xhi = nest
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.theta_profile_z  = 0.
bc.theta_profile    = 300.
forcing.gravity = 0.

turb.tke_floor       = 1.e-6
turb.realizability   = 0.309
turb.nut_relax       = 0.5
convection.hybrid_sigma_max = 0.1

buildings.type   = immersed_forcing

init.first_guess = nest

steady.stage          = simplec
steady.sweep          = zjacobi
steady.zline_sweeps   = 3
