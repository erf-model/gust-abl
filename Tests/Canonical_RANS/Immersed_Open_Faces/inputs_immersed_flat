# The flat ground of inputs_body_fitted_flat immersed in a flat mesh with three more layers of 15.625 m below it;
# terrain.flat_height (46.875 m for a ground on a cell face) is given on the command line (README.md).
mesh.n_cell        = 64 4 67
mesh.prob_lo       = 0. 0. 0.
mesh.prob_hi       = 2560. 160. 1046.875
mesh.is_periodic   = 0 1 0
mesh.max_grid_size = 32 4

terrain.type = flat
terrain.representation = immersed_forcing

bc.xlo = inflow
bc.xhi = outflow
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0 = 0.1
bc.theta_profile_z = 0.
bc.theta_profile   = 300.
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.35
bc.inflow_z0        = 0.1
bc.inflow_direction = 0.

init.first_guess = profile

forcing.gravity = 0.

# The recommended setting (docs/turbulence_model.rst).
turb.tke_floor       = 1.e-6
turb.realizability   = 0.309
turb.nut_relax       = 0.5
turb.max_geom_lscale = 100.
convection.hybrid_sigma_max = 0.1
convection.hybrid_height    = 250.

steady.stage                   = simplec
steady.sweep                   = zjacobi
steady.cfl0                    = 1.
steady.cfl_max                 = 4.
steady.zline_sweeps            = 16
steady.residual_ref_iterations = 100
steady.residual_drop_orders    = 4
steady.max_iterations          = 20000

solver.poisson_backend = gmres_fft

io.plot_file      = immersed_flat_plt
io.turb_plot_file = immersed_flat_turb
io.write_checkpoint = 0
