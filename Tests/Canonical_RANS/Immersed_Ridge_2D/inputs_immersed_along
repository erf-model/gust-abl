# The ridge as an immersed ground on a flat mesh: two more layers of 15.625 m below the terrain's zero level
# (README.md), with the wind along the ridge: a 2-D Witch of Agnesi ridge, 100 m high, half-width 200 m
# (slopes up to 18 degrees across the wind), uniform theta, no gravity, a force of 1.225e-4 m/s2 along y,
# periodic in x and y, z0 = 0.1 m.
mesh.n_cell        = 128 1 66
mesh.prob_lo       = -2560. 0. 0.
mesh.prob_hi       =  2560. 40. 1031.25
mesh.is_periodic   = 1 1 0
mesh.max_grid_size = 32 1

terrain.type            = agnesi
terrain.hill_shape      = ridge_x
terrain.hill_height     = 100.
terrain.hill_half_width = 200.
terrain.representation  = immersed_forcing
terrain.flat_height     = 31.25
# terrain.immersed_slope (vertical or normal) is given on the command line.

bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0 = 0.1
bc.theta_profile_z = 0.
bc.theta_profile   = 300.
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.35
bc.inflow_z0        = 0.1
bc.inflow_direction = 90.

init.first_guess = profile

forcing.gravity           = 0.
forcing.pressure_gradient = 0. 1.225e-4 0.

# The recommended setting (docs/turbulence_model.rst).
turb.tke_floor       = 1.e-6
turb.realizability   = 0.309
turb.nut_relax       = 0.5
turb.max_geom_lscale = 100.
convection.hybrid_sigma_max = 0.1
convection.hybrid_height    = 250.

steady.stage                   = simplec
steady.sweep                   = zjacobi   # z-line Jacobi sweep (the CPU default is lusgs)
steady.cfl0                    = 1.
steady.cfl_max                 = 50.
steady.zline_sweeps            = 16
steady.residual_ref_iterations = 100
steady.residual_drop_orders    = 4
steady.max_iterations          = 20000

solver.poisson_backend = gmres_fft

io.plot_file      = immersed_along_plt
io.turb_plot_file = immersed_along_turb
io.chk_file       = immersed_along_chk
