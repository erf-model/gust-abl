# The ridge on a hybrid mesh (terrain.representation = hybrid), with terrain.flat_height and
# terrain.hybrid_half_width not given: the run takes their defaults (one first layer, 15.625 m, and
# 2 cells, 80 m) and writes a checkpoint after two iterations for inputs_hybrid_restart.
mesh.n_cell        = 128 1 64
mesh.prob_lo       = -2560. 0. 0.
mesh.prob_hi       =  2560. 40. 1000.
mesh.is_periodic   = 1 1 0
mesh.max_grid_size = 32 1

terrain.type            = agnesi
terrain.hill_shape      = ridge_x
terrain.hill_height     = 100.
terrain.hill_half_width = 500.
terrain.representation  = hybrid

bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0 = 0.1
bc.theta_profile_z = 0.
bc.theta_profile   = 300.
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.35
bc.inflow_z0        = 0.1
bc.inflow_direction = 0.
bc.rayleigh_zdamp    = 731.25
bc.rayleigh_dampcoef = 0.2
bc.rayleigh_fields   = w

init.first_guess = profile

forcing.gravity         = 0.
forcing.coriolis        = 1
forcing.coriolis_3d     = 0
forcing.latitude        = 90.
forcing.rotation_period = 125663.7061435917
forcing.geostrophic     = 1
forcing.ug              = 10.
forcing.vg              = 0.

# The recommended setting without the near-ground blend, which a restart refuses.
turb.tke_floor       = 1.e-6
turb.realizability   = 0.309
turb.nut_relax       = 0.5
turb.max_geom_lscale = 100.

steady.stage          = simplec
steady.sweep          = zjacobi
steady.max_iterations = 2

solver.poisson_backend = gmres_fft

io.plot_file = hybrid_ground_plt
io.chk_file  = hybrid_ground_chk
