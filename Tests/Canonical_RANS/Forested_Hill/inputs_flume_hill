# The flume of Poggi, Katul, Finnigan and Belcher (2008) scaled by 100, in a neutral flow driven by a
# constant pressure gradient (Canonical_RANS/Forested_Hill): a train of cosine hills, H = 8 m,
# L = 80 m (one period 320 m), a uniform canopy 10 m tall. The paper states no depth: 61.5 m of lid height is a
# choice, from its Q and Fr_b < 0.1 (depth above about 0.57 m in the flume). F only sets the speed scale, u* = 0.5 m/s.
# 80 x 4 x 53 cells, a 0.25 m first layer stretched by 1.05. The check gives the tables and the LAI.
mesh.n_cell = 80 4 53
mesh.prob_lo = 0. 0. 0.
mesh.prob_hi = 320. 16. 61.5
mesh.is_periodic = 1 1 0
mesh.max_grid_size = 20 4
mesh.dz0 = 0.25
mesh.stretch_ratio = 1.05
terrain.type = xyz
terrain.file = t.xyz
terrain.smoothing = 0
abl.drive = pressure_driven
abl.theta = neutral
init.first_guess = profile
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0 = 0.001
bc.theta_profile_z = 0.
bc.theta_profile = 300.
bc.inflow_profile = log_law
bc.inflow_ustar = 0.5
bc.inflow_z0 = 0.001
bc.inflow_direction = 0.
forcing.gravity = 0.
forcing.pressure_gradient = 4.07e-3 0. 0.
canopy.type = map
canopy.height_file = h.xyz
canopy.lai_file = lai.xyz
canopy.cd = 0.2
turb.tke_floor = 1.e-6
steady.stage = simplec
steady.dtau_floor = 1
io.plot_file = hill_plt
io.chk_file = hill_chk
