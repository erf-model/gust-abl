# Plan rev. 6, sub-phase 6.2 (beyond the plan), RT-6.2.1: the 2-D hill of
# Tests/Canonical_RANS/Neutral_Hill_2D/inputs_steady_hill2d_restart (ERF's
# Neutral_Hill_2D: the Witch of Agnesi ridge, 100 m high, half-width 500 m,
# on 128 x 1 x 64 cells, the surface layer, Coriolis and the geostrophic wind
# (10, 0) m/s) run as unsteady RANS by dual time stepping: ten backward-Euler
# steps of 60 s from the log-law first guess to t = 600 s, each step converged
# by SIMPLEC pseudo-time iterations two orders below its starting residual
# (at most 60). The checkpoint is off (not supported with steady.stage =
# unsteady yet). check_unsteady_hill2d.py gives init.first_guess = profile,
# unsteady.stop_time, unsteady.dt and io.write_checkpoint = 0 on the command
# line (600 s in steps of 60 s, and one step of 1e-3 s; a key may be given
# once). The abort tests of Tests/CMakeLists.txt leave one of them out.
mesh.n_cell        = 128 1 64
mesh.prob_lo       = -2560. 0. 0.
mesh.prob_hi       =  2560. 40. 1000.
mesh.is_periodic   = 1 1 0
mesh.max_grid_size = 64 1

terrain.type            = agnesi
terrain.hill_shape      = ridge_x
terrain.hill_height     = 100.
terrain.hill_half_width = 500.
terrain.smoothing       = 0

bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0 = 0.1
bc.theta_profile_z = 0. 700. 1000.
bc.theta_profile   = 300. 300. 309.
bc.zhi_theta_grad  = 0.03
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.35
bc.inflow_z0        = 0.1
bc.inflow_direction = 0.
bc.rayleigh_zdamp    = 700.
bc.rayleigh_dampcoef = 0.2
bc.rayleigh_fields   = w theta

forcing.coriolis        = 1
forcing.coriolis_3d     = 0
forcing.latitude        = 90.
forcing.rotation_period = 125663.7061435917
forcing.geostrophic     = 1
forcing.ug              = 10.
forcing.vg              = 0.

turb.tke_floor = 1.e-6

steady.stage                   = unsteady
steady.sweep                   = zjacobi   # z-line Jacobi sweep (the CPU default is lusgs)
steady.cfl0                    = 1.
steady.cfl_max                 = 4.
steady.zline_sweeps            = 16
simplec.rotation_relax         = 1.   # with the planar-mean split 1 converges in half the iterations of 0.3 (docs/solver.rst)
steady.residual_ref_iterations = 100

unsteady.inner_drop_orders = 2
unsteady.max_inner         = 60

io.plot_file        = unsteady_hill2d_plt
