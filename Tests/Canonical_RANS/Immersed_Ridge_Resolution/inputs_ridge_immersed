# Grid-resolution case (README.md): the 2-D Agnesi ridge, 200 m high, half-width 500 m (slopes up to 15 deg), as an
# immersed ground on a flat mesh. dx = 64 m here; other dx in a copy (README.md).
# Layers from make_levels.py (2 m to 224 m, then stretched to 1002 m), written as zlevels.txt.
# Partner: inputs_ridge_body_fitted. Settings follow ../Immersed_Ridge_2D/inputs_immersed_ridge.
# Uniform theta, no gravity: a geostrophic wind of 10 m/s with Coriolis, periodic in x and y, z0 = 0.1 m.
mesh.n_cell        = 128 1 149
mesh.prob_lo       = -4096.0 0. 0.
mesh.prob_hi       = 4096.0 40. 1002.0
mesh.is_periodic   = 1 1 0
mesh.max_grid_size = 64 1
mesh.zlevels_file  = zlevels.txt

terrain.type            = agnesi
terrain.hill_shape      = ridge_x
terrain.hill_height     = 200.0
terrain.hill_half_width = 500.0
terrain.representation  = immersed_forcing
terrain.flat_height     = 2.0

bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0 = 0.1
bc.theta_profile_z = 0.
bc.theta_profile   = 300.
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.35
bc.inflow_z0        = 0.1
bc.inflow_direction = 0.
bc.rayleigh_zdamp    = 733.25
bc.rayleigh_dampcoef = 0.2
bc.rayleigh_fields   = w

init.first_guess = profile

forcing.gravity         = 0.
forcing.coriolis        = 1
forcing.coriolis_3d     = 0
forcing.latitude        = 90.
forcing.rotation_period = 125663.7061435917
forcing.geostrophic     = 1
forcing.ug              = 10.
forcing.vg              = 0.

# The recommended setting (docs/turbulence_model.rst).
turb.tke_floor       = 1.e-6
turb.realizability   = 0.309
turb.nut_relax       = 0.5
turb.max_geom_lscale = 100.
convection.hybrid_sigma_max = 0.1
convection.hybrid_height    = 250.

steady.stage                   = simplec
steady.sweep                   = zjacobi   # z-line Jacobi sweep (the CPU default is lusgs)
steady.cfl0                    = 1.
steady.cfl_max                 = 4.
steady.zline_sweeps            = 16
simplec.rotation_relax         = 1.
steady.residual_ref_iterations = 100
steady.residual_drop_orders    = 4
steady.max_iterations          = 20000

solver.poisson_backend = gmres_fft

io.plot_file      = ridge_immersed_plt
io.turb_plot_file = ridge_immersed_turb
io.chk_file       = ridge_immersed_chk
turb.shear_stencil = log_law
terrain.small_volfrac = 0.1
terrain.immersed_slope = vertical
