# The refusals of turb.closure = none (App.cpp, docs/inputs.rst turb.closure): the cylinder deck
# with the ground's wall law and the buildings' form 7 wall law, both of which need the k-L
# closure. CTest abort_laminar_cross_checks expects one message for each. buildings.file and
# bc.inflow_file on the command line, as for inputs_cylinder.
mesh.prob_lo       = -6. 0. 0.
mesh.prob_hi       = 14. 0.1 12.
mesh.n_cell        = 200 2 120
mesh.is_periodic   = 0 1 0
mesh.max_grid_size = 64 2

terrain.type = flat

bc.xlo = inflow
bc.xhi = outflow
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.inflow_profile = file
bc.theta_profile_z = 0.
bc.theta_profile   = 300.

forcing.gravity = 0.

turb.closure         = none
turb.nu_molecular    = 0.025

buildings.type      = immersed_forcing
buildings.format    = xyz
buildings.wall_form = fraction_stress

init.first_guess = profile

steady.stage = simplec
steady.sweep = zjacobi
io.write_checkpoint = 0
