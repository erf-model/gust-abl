# inputs_cube without a stage or first guess (a restart refuses it), for the force file's unsteady CTests (PR-49): the
# command line gives steady.stage = unsteady and the unsteady keys, and io.restart for the restart.
# The same run with and without buildings.force_file must be bit-identical, and a restart must
# reproduce the uninterrupted force file. buildings.file on the command line: cube.txt.
mesh.n_cell        = 48 24 24
mesh.prob_lo       = 0. 0. 0.
mesh.prob_hi       = 240. 120. 120.
mesh.is_periodic   = 0 1 0
mesh.max_grid_size = 16 12

terrain.type = flat

bc.xlo = inflow
bc.xhi = outflow
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0       = 0.1
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.4
bc.inflow_z0        = 0.1
bc.inflow_direction = 0.
bc.theta_profile_z  = 0.
bc.theta_profile    = 300.

forcing.gravity = 0.
turb.tke_floor  = 1.e-6
turb.max_geom_lscale = 40.

buildings.type = immersed_forcing
buildings.z0   = 0.1

steady.sweep          = zjacobi

io.plot_file = cube_plt
io.write_checkpoint = 1
