# The block of inputs_cube with walls 5 K warmer than the air (buildings.theta_mode = fixed, buildings.theta_surface
# = 305 K on a 300 K flow) and gravity on, so the warmed air is buoyant. Not a validation: the deck pins that the
# iteration converges with the walls' heat exchange, the solid cells at 305 K and the heat the walls give.
# buildings.file on the command line: cube.txt.
mesh.n_cell        = 48 24 24
mesh.prob_lo       = 0. 0. 0.
mesh.prob_hi       = 240. 120. 120.
mesh.is_periodic   = 0 1 0
mesh.max_grid_size = 16 12

terrain.type = flat

bc.xlo = inflow
bc.xhi = outflow
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0       = 0.1
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.4
bc.inflow_z0        = 0.1
bc.inflow_direction = 0.
bc.theta_profile_z  = 0.
bc.theta_profile    = 300.

forcing.gravity = 9.81
turb.tke_floor  = 1.e-6
turb.max_geom_lscale = 40.

buildings.type = immersed_forcing
buildings.z0   = 0.1
buildings.theta_mode    = fixed
buildings.theta_surface = 305.

init.first_guess = profile

steady.stage          = simplec
steady.sweep          = zjacobi
steady.zline_sweeps   = 3
steady.cfl_max        = 8
steady.max_iterations = 300

io.plot_file = cube_plt
io.write_checkpoint = 0
