# The immersed ground's checkpoint (terrain.representation = immersed_forcing): one iteration of the
# column, so the run writes a checkpoint with the ground's record (ImmersedTerrain) that a stage can
# restart from. The column's mesh; terrain.flat_height is given on the command line.
mesh.n_cell        = 4 4 67
mesh.prob_hi       = 2560. 2560. 1046.875
mesh.is_periodic   = 1 1 0
mesh.max_grid_size = 2 4

terrain.type = flat
terrain.representation = immersed_forcing

bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0 = 0.1
bc.theta_profile_z = 0.
bc.theta_profile   = 300.
bc.inflow_profile  = log_law
bc.inflow_ustar    = 0.25
bc.inflow_z0       = 0.1
bc.inflow_direction = 0.

init.first_guess = profile

turb.max_geom_lscale = 1.0e12
turb.face_mean       = logarithmic

forcing.pressure_gradient = 1.225e-4 0. 0.

steady.stage          = simplec
steady.sweep          = zjacobi
steady.max_iterations = 1
solver.poisson_backend = gmres_fft

io.plot_file = immersed_ground_plt
io.chk_file  = immersed_ground_chk
