# A nested patch of the one-way nesting validation (sub-phase 9.3, beyond plan
# rev. 6): a square of half-width d centred on the hill of inputs_hill_domain,
# at refinement 2 2 1 of its parent, with four nest faces and the parent's
# field as the first guess. nest_validation.py gives the patch's place and
# cells (mesh.prob_lo, mesh.prob_hi, mesh.n_cell), its parent
# (bc.nest_parent), the boxes (mesh.max_grid_size, 48 unless the command gives
# it) and, for the zone comparison, bc.nest_relax_width on the command line,
# and names the outputs. The hill of terrain.type = agnesi is
# centred in the domain, so a patch centred on (1600, 1200) m has the parent's
# hill.
mesh.is_periodic   = 0 0 0
mesh.dz0           = 10.

terrain.type            = agnesi
terrain.hill_shape      = round
terrain.hill_height     = 150.
terrain.hill_half_width = 250.
terrain.smoothing       = 0

bc.xlo = nest
bc.xhi = nest
bc.ylo = nest
bc.yhi = nest
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0 = 0.1

init.first_guess = nest

steady.stage          = simplec
steady.max_iterations = 4000
