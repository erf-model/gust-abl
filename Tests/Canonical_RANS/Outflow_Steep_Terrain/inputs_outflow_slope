# Steep terrain at an outflow face: a 2-D domain (2400 m x 32 m, y periodic) that ends on the steepest part of a
# rising cos^2 ridge (crest 50 m beyond the outflow face; max slope 32 deg). terrain.file on the command line:
# outflow_slope.xyz (the cut slope) or outflow_slope_flat.xyz (no normal slope over the last 100 m), both from
# make_terrain.py. Log-law inflow (u* 0.21 m/s, z0 0.01 m) on xlo, outflow on xhi, slip top, no gravity; the grid of
# the Ishihara-Zhou ridge case (4 m cells, 0.5 m first layer stretched by 1.081); the limit of the realizability
# sensor without the near-ground blending (C_r = 0.309, nu_t relaxation 1).
mesh.n_cell           = 600 8 64
mesh.prob_lo          = 0. 0. 0.
mesh.prob_hi          = 2400. 32. 896.
mesh.is_periodic      = 0 1 0
mesh.max_grid_size    = 40 8
mesh.dz0              = 0.5
mesh.stretch_ratio    = 1.081
mesh.hierarchy_levels = 3

terrain.type      = xyz
terrain.smoothing = 0

bc.xlo = inflow
bc.xhi = outflow
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0       = 0.01
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.21
bc.inflow_z0        = 0.01
bc.inflow_direction = 0.
bc.theta_profile_z  = 0.
bc.theta_profile    = 300.

forcing.gravity = 0.
turb.tke_floor  = 1.e-6
turb.max_geom_lscale = 100.
turb.realizability   = 0.309
turb.nut_relax       = 1
simplec.w_vnn_cap = 16

init.first_guess = profile

steady.stage          = simplec
steady.sweep          = lusgs
steady.zline_sweeps   = 2
steady.cfl_max        = 16
steady.sequencing     = 1

io.write_plotfile   = 0
io.write_checkpoint = 0
