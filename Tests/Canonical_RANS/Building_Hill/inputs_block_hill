# One block (30 x 30 m, 20 m high above the local ground) on the windward flank of a 30 m ridge, in a log-law wind:
# the building terms over terrain, where the block's floor and roof follow the ground. 5 m cells, inflow at xlo, outflow
# at xhi, periodic in y, no gravity. Not a validation (PR-44 has those). buildings.file on the command line: block.txt.
mesh.n_cell        = 96 32 32
mesh.prob_lo       = 0. 0. 0.
mesh.prob_hi       = 480. 160. 160.
mesh.is_periodic   = 0 1 0
mesh.max_grid_size = 24 16

terrain.type            = agnesi
terrain.hill_shape      = ridge_x
terrain.hill_height     = 30.
terrain.hill_half_width = 100.
terrain.smoothing       = 0

bc.xlo = inflow
bc.xhi = outflow
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0       = 0.1
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.4
bc.inflow_z0        = 0.1
bc.inflow_direction = 0.
bc.theta_profile_z  = 0.
bc.theta_profile    = 300.

forcing.gravity = 0.
turb.tke_floor  = 1.e-6
turb.max_geom_lscale = 40.

buildings.type = immersed_forcing
buildings.z0   = 0.1

init.first_guess = profile

steady.stage          = simplec
steady.sweep          = zjacobi
steady.zline_sweeps   = 3
steady.cfl_max        = 8
steady.max_iterations = 600

io.plot_file = block_hill_plt
io.write_checkpoint = 0
