# A courtyard open to the wind: a wall 30 m wide with two wings (10 x 10 m each, all 20 m high) and a 10 m annex
# behind it, on flat ground in a log-law wind, 5 m cells. The inner corners of the courtyard and the annex's roof
# against the wall are corner and edge cells of the wall law: cells with two walls, where one face of a velocity
# component lies on the other wall. Not a validation (PR-44 has those); the deck pins k in those cells with the
# speed from the open faces (the default) and from every face (buildings.wall_speed = all_faces, the earlier form).
# buildings.file on the command line: courtyard.txt.
mesh.n_cell        = 48 24 24
mesh.prob_lo       = 0. 0. 0.
mesh.prob_hi       = 240. 120. 120.
mesh.is_periodic   = 0 1 0
mesh.max_grid_size = 16 12

terrain.type = flat

bc.xlo = inflow
bc.xhi = outflow
bc.zlo = surface_layer
bc.zhi = slip_wall
bc.surface_z0       = 0.1
bc.inflow_profile   = log_law
bc.inflow_ustar     = 0.4
bc.inflow_z0        = 0.1
bc.inflow_direction = 0.
bc.theta_profile_z  = 0.
bc.theta_profile    = 300.

forcing.gravity = 0.
turb.tke_floor  = 1.e-6
turb.max_geom_lscale = 40.

buildings.type = immersed_forcing
buildings.z0   = 0.1

init.first_guess = profile

steady.stage          = simplec
steady.sweep          = zjacobi
steady.zline_sweeps   = 3
steady.cfl_max        = 8
steady.max_iterations = 400

io.plot_file = courtyard_plt
io.write_checkpoint = 0
